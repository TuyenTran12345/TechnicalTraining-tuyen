	        		<record id="balance_sheet_c133_b01a_line_01_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">BS133_b01a_110.balance + BS133_b01a_120.balance + BS133_b01a_130.balance + BS133_b01a_140.balance + BS133_b01a_150.balance + BS133_b01a_160.balance + BS133_b01a_170.balance + BS133_b01a_180.balance</field>
	        		</record>
        		</field>
        		<field name="children_ids">
        			<record id="balance_sheet_c133_b01a_line_01_01" model="account.report.line">
        				<field name="name">I. Cash and Cash Equivalents</field>
        				<field name="code">BS133_b01a_110</field>
        				<field name="display_code">110</field>
        				<field name="groupby">account_id</field>
        				<field name="expression_ids">
        					<record id="balance_sheet_c133_b01a_line_01_01_exp_01" model="account.report.expression">
        						<field name="label">balance</field>
        						<field name="engine">domain</field>
			        			<field name="formula">[('account_id.account_type', '=', 'asset_cash')]</field>
			        			<field name="subformula">sum</field>
        					</record>
        				</field>
        			</record>
        			<record id="balance_sheet_c133_b01a_line_01_02" model="account.report.line">
        				<field name="name">II. Short-term financial investments (120 = 121 + 122 + 123 + 124)</field>
