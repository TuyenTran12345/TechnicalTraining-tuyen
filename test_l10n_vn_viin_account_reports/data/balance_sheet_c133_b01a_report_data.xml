			        		<record id="balance_sheet_c133_b01a_line_01_05_exp_01" model="account.report.expression">
			        			<field name="label">balance</field>
			        			<field name="engine">aggregation</field>
			        			<field name="formula">BS133_b01a_151.balance + BS133_b01a_152.balance</field>
			        		</record>
		        		</field>
		        		<field name="children_ids">
		        			<record id="balance_sheet_c133_b01a_line_01_05_01" model="account.report.line">
