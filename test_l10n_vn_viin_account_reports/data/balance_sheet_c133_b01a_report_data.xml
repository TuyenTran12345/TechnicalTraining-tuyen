        				<field name="display_code">120</field>
        				<field name="expression_ids">
			        		<record id="balance_sheet_c133_b01a_line_01_02_exp_01" model="account.report.expression">
			        			<field name="label">balance</field>
			        			<field name="engine">aggregation</field>
			        			<field name="formula">BS133_b01a_121.balance + BS133_b01a_122.balance + BS133_b01a_123.balance + BS133_b01a_124.balance</field>
			        		</record>
		        		</field>
		        		<field name="children_ids">
		        			<record id="balance_sheet_c133_b01a_line_01_02_01" model="account.report.line">
