		        				<field name="code">BS133_b01a_121</field>
		        				<field name="display_code">121</field>
		        				<field name="groupby">account_id</field>
		        				<field name="expression_ids">
			        				<record id="balance_sheet_c133_b01a_line_01_02_01_exp_01" model="account.report.expression">
		        						<field name="label">balance</field>
		        						<field name="engine">domain</field>
					        			<field name="formula">[('account_id.code','=like','121%')]</field>
					        			<field name="subformula">sum</field>
		        					</record>
	        					</field>
		        			</record>
		        			<record id="balance_sheet_c133_b01a_line_01_02_02" model="account.report.line">
