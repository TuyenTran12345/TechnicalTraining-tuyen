		        				<field name="groupby">account_id</field>
		        				<field name="expression_ids">
			        				<record id="balance_sheet_c133_b01a_line_01_02_02_exp_01" model="account.report.expression">
		        						<field name="label">balance</field>
		        						<field name="engine">domain</field>
					        			<field name="formula">[
					        				'|',
					        				('account_id.code','=like','1281%'),
    										('account_id.code','=like','1288%')]</field>
					        			<field name="subformula">sum</field>
		        					</record>
	        					</field>
		        			</record>
		        			<record id="balance_sheet_c133_b01a_line_01_02_03" model="account.report.line">
