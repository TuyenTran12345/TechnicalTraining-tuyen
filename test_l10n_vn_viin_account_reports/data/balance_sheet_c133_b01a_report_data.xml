		        			</record>
		        			<record id="balance_sheet_c133_b01a_line_01_05_02" model="account.report.line">
		        				<field name="name">- Accumulated depreciation</field>
		        				<field name="code">BS133_b01a_152</field>
		        				<field name="display_code">152</field>
		        				<field name="groupby">account_id</field>
		        				<field name="expression_ids">
			        				<record id="balance_sheet_c133_b01a_line_01_05_02_exp_01" model="account.report.expression">
		        						<field name="label">balance</field>
		        						<field name="engine">domain</field>
					        			<field name="formula">[
					        				('account_id.code','=like','214%'),
					        				('account_id.code','not like','2147%')]</field>
					        			<field name="subformula">sum</field>
		        					</record>
	        					</field>
		        			</record>
