<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="profit_and_loss_c133_report" model="account.report">
		<field name="name">Profit and Loss (B02-DNN)</field>
		<field name="default_opening_date_filter">this_year</field>
		<field name="filter_unfold_all" eval="True"/>
		<field name="filter_journals" eval="True"/>
		<field name="show_line_code" eval="True"/>
		<field name="root_report_id" ref="to_account_reports.profit_and_loss_report"/>
		<field name="availability_condition">coa</field>
		<field name="chart_template_id" ref="l10n_vn_viin.vn_template_c133"/>
		<field name="template_ref">Template B02-DNN</field>
		<field name="column_ids">
            <record id="profit_and_loss_c133_column_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
        	<record id="profit_and_loss_c133_line_01" model="account.report.line">
        		<field name="name">1. Revenues from sales and services rendered</field>
        		<field name="code">PL133_01</field>
        		<field name="display_code">01</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_01_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.account_type', '=', 'income'),
 							('ctp_account_ids.account_type', 'not in', ['equity_unaffected']),
 							('credit', '>', 0)]</field>
	        			<field name="subformula">-sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_02" model="account.report.line">
        		<field name="name">2. Revenue deductions</field>
        		<field name="code">PL133_02</field>
        		<field name="display_code">02</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_02_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.account_type', '=', 'income'),
 							('ctp_account_ids.account_type', 'not in', ['equity_unaffected']),
 							('debit', '>', 0)]</field>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_03" model="account.report.line">
        		<field name="name">3. Net revenues from sales and services rendered (10 = 01 - 02)</field>
        		<field name="code">PL133_10</field>
        		<field name="display_code">10</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_03_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">PL133_01.balance - PL133_02.balance</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_04" model="account.report.line">
        		<field name="name">4. Costs of goods sold</field>
        		<field name="code">PL133_11</field>
        		<field name="display_code">11</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_04_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				'|', '|', '|', '|', '|',
	        				('account_id.code','=like','611%'),
	        				('account_id.code','=like','621%'),
	        				('account_id.code','=like','622%'),
	        				('account_id.code','=like','623%'),
	        				('account_id.code','=like','627%'),
	        				'&amp;',
	        				('account_id.account_type', '=', 'expense_direct_cost'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_05" model="account.report.line">
        		<field name="name">5. Gross revenues from sales and services rendered (20 = 10 - 11)</field>
        		<field name="code">PL133_20</field>
        		<field name="display_code">20</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_05_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">PL133_10.balance - PL133_11.balance</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_06" model="account.report.line">
        		<field name="name">6. Financial income</field>
        		<field name="code">PL133_21</field>
        		<field name="display_code">21</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_06_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.code','=like','515%'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">-sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_07" model="account.report.line">
        		<field name="name">7. Financial expenses</field>
        		<field name="code">PL133_22</field>
        		<field name="display_code">22</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_07_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.code','=like','635%'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_08" model="account.report.line">
        		<field name="name">- In which: Interest expenses</field>
        		<field name="code">PL133_23</field>
        		<field name="display_code">23</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_08_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula" eval="[
	        				('account_id.code','=like','635%'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected']),
                            ('analytic_tag_ids', 'in', [ref('viin_analytic_tag.account_analytic_tag_borrowing_loan')])
                        ]"/>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_09" model="account.report.line">
        		<field name="name">8. Business administration expenses</field>
        		<field name="code">PL133_24</field>
        		<field name="display_code">24</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_09_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.code','=like','642%'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_10" model="account.report.line">
        		<field name="name">9. Net profits from operating activities 30 = 20 + 21 - 22 - 24</field>
        		<field name="code">PL133_30</field>
        		<field name="display_code">30</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_10_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">PL133_20.balance + PL133_21.balance - PL133_22.balance - PL133_24.balance</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_11" model="account.report.line">
        		<field name="name">10. Other Income</field>
        		<field name="code">PL133_31</field>
        		<field name="display_code">31</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_11_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.account_type', '=', 'income_other'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">-sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_12" model="account.report.line">
        		<field name="name">11. Other Expenses</field>
        		<field name="code">PL133_32</field>
        		<field name="display_code">32</field>
        		<field name="hierarchy_level">3</field>
        		<field name="groupby">account_id</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_12_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.code','=like','811%'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_13" model="account.report.line">
        		<field name="name">12. Other profits (40 = 31 - 32)</field>
        		<field name="code">PL133_40</field>
        		<field name="display_code">40</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_13_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">PL133_31.balance - PL133_32.balance</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_14" model="account.report.line">
        		<field name="name">13. Total net profits before tax (50 = 30 + 40)</field>
        		<field name="code">PL133_50</field>
        		<field name="display_code">50</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_14_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">PL133_30.balance + PL133_40.balance</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_15" model="account.report.line">
        		<field name="name">14. Current corporate income tax expenses</field>
        		<field name="code">PL133_51</field>
        		<field name="display_code">51</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_15_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">domain</field>
	        			<field name="formula">[
	        				('account_id.code','=like','821%'),
	        				('ctp_account_ids.account_type', 'not in', ['equity_unaffected'])]</field>
	        			<field name="subformula">sum</field>
	        		</record>
        		</field>
        	</record>
        	<record id="profit_and_loss_c133_line_16" model="account.report.line">
        		<field name="name">15. Profits after enterprise income tax (60 = 50 - 51)</field>
        		<field name="code">PL133_60</field>
        		<field name="display_code">60</field>
        		<field name="hierarchy_level">3</field>
        		<field name="expression_ids">
        			<record id="profit_and_loss_c133_line_16_exp_01" model="account.report.expression">
	        			<field name="label">balance</field>
	        			<field name="engine">aggregation</field>
	        			<field name="formula">PL133_50.balance - PL133_51.balance</field>
	        		</record>
        		</field>
        	</record>
        </field>
        <field name="custom_report_header_template">l10n_vn_viin_account_reports.header_template_print_vn</field>
        <field name="custom_report_body_template">l10n_vn_viin_account_reports.main_template_print_vn</field>
        <field name="custom_report_footer_template">l10n_vn_viin.accounting_external_footer_layout</field>
    </record>

</odoo>
