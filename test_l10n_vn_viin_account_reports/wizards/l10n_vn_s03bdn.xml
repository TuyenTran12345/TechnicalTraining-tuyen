<odoo>
	<record id="account_common_report_s03bdn_view" model="ir.ui.view">
		<field name="name">L10n VN S03b-DN Form</field>
		<field name="model">l10n_vn.s03bdn</field>
		<field name="inherit_id" ref="viin_account.account_common_report_view" />
		<field name="arch" type="xml">
			<data>
				<xpath expr="//field[@name='journal_ids']" position="before">
					<field name="target_type" invisible="1"></field>
					<field name="account_ids" widget="many2many_tags" options="{'no_create': True}" attrs="{'invisible': [('target_type', '!=', 'account')], 'required': [('target_type', '=', 'account')]}" />
					<field name="check_split_counterpart_line"></field>
					<field name="include_extra_info" />
					<newline />
				</xpath>
				<xpath expr="//field[@name='journal_ids']" position="attributes">
					<attribute name="attrs">{'invisible': [('target_type', '!=', 'journal')], 'required': [('target_type', '=', 'journal')]}</attribute>
					<attribute name="options">{'no_create': True}</attribute>
				</xpath>
				<xpath expr="//button[@name='check_report']" position="after">
					<button name="check_report_excel" string="Export Excel" type="object" class="oe_highlight" />
				</xpath>
				<xpath expr="//field[@name='target_move']" position="attributes">
					<attribute name="readonly">1</attribute>
				</xpath>
			</data>
		</field>
	</record>

	<record id="l10n_vn_s03bdn_action" model="ir.actions.act_window">
		<field name="name">LEDGER (S03b-DN)</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">l10n_vn.s03bdn</field>
		<field name="view_mode">form</field>
		<field name="view_id" ref="account_common_report_s03bdn_view" />
		<field name="target">new</field>
	</record>

	<menuitem id="l10n_vn_s03bdn_menu"
	name="Ledger (S03b-DN)"
	parent="l10n_vn_viin.account_reports_vn_menu"
	groups="account.group_account_user"
	action="l10n_vn_s03bdn_action"
	sequence="4"/>
</odoo>
