<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="balance_sheet_report" model="account.report">
		<field name="name">Balance Sheet</field>
		<field name="default_opening_date_filter">today</field>
		<field name="filter_date_range" eval="False"/>
		<field name="filter_unfold_all" eval="True"/>
		<field name="filter_journals" eval="True"/>
		<field name="column_ids">
            <record id="balance_sheet_column_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
        	<record id="balance_sheet_line_01" model="account.report.line">
        		<field name="name">ASSETS</field>
        		<field name="code">TA</field>
        		<field name="aggregation_formula">CA.balance + FA.balance + PNCA.balance</field>
        		<field name="children_ids">
        			<record id="balance_sheet_line_01_01" model="account.report.line">
        				<field name="name">Current Assets</field>
        				<field name="code">CA</field>
        				<field name="aggregation_formula">BA.balance + REC.balance + CAS.balance + PRE.balance</field>
        				<field name="children_ids">
        					<record id="balance_sheet_line_01_01_01" model="account.report.line">
                                <field name="name">Bank and Cash Accounts</field>
                                <field name="code">BA</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="domain_formula">sum([('account_id.account_type', '=', 'asset_cash')])</field>
                            </record>
                            <record id="balance_sheet_line_01_01_02" model="account.report.line">
                                <field name="name">Receivables</field>
                                <field name="code">REC</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="domain_formula">sum([('account_id.account_type', '=', 'asset_receivable'), ('account_id.non_trade', '=', False)])</field>
                            </record>                            
                            <record id="balance_sheet_line_01_01_03" model="account.report.line">
                                <field name="name">Current Assets</field>
                                <field name="code">CAS</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="domain_formula">sum(['|', ('account_id.account_type', '=', 'asset_current'), '&amp;', ('account_id.account_type', '=', 'asset_receivable'), ('account_id.non_trade', '=', True)])</field>
                            </record>
                            <record id="balance_sheet_line_01_01_04" model="account.report.line">
                            	<field name="name">Prepayments</field>
                                <field name="code">PRE</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="domain_formula">sum([('account_id.account_type', '=', 'asset_prepayments')])</field>
                            </record>
        				</field>
        			</record>
        			<record id="balance_sheet_line_01_02" model="account.report.line">
        				<field name="name">Plus Fixed Assets</field>
                        <field name="code">FA</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="domain_formula">sum([('account_id.account_type', 'in', ('asset_fixed', 'asset_fixed'))])</field>
        			</record>
        			<record id="balance_sheet_line_01_03" model="account.report.line">
        				<field name="name">Plus Non-current Assets</field>
                        <field name="code">PNCA</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="domain_formula">sum([('account_id.account_type', '=', 'asset_non_current')])</field>
        			</record>
        		</field>
        	</record>
        	<record id="balance_sheet_line_02" model="account.report.line">
        		<field name="name">LIABILITIES</field>
        		<field name="code">L</field>
        		<field name="expression_ids">
                    <record id="balance_sheet_line_02_exp_01" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">CL.balance + NL.balance</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
        		<field name="children_ids">
        			<record id="balance_sheet_line_02_01" model="account.report.line">
        				<field name="name">Current Liabilities</field>
                        <field name="code">CL</field>
                        <field name="expression_ids">
                            <record id="balance_sheet_line_02_01_exp_01" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">CL1.balance + CL2.balance</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                        <field name="children_ids">
                        	<record id="balance_sheet_line_02_01_01" model="account.report.line">
                        		<field name="name">Current Liabilities</field>
                                <field name="code">CL1</field>
                                <field name="groupby">account_id</field>
                                <field name="expression_ids">
                                    <record id="balance_sheet_line_02_01_01_exp_01" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula">
                                        	['|', 
                                        	('account_id.account_type', 'in', ('liability_current', 'liability_credit_card')), '&amp;', 
                                        	('account_id.account_type', '=', 'liability_payable'), ('account_id.non_trade', '=', True)]</field>
                                        <field name="subformula">-sum</field>
                                        <field name="green_on_positive" eval="False"/>
                                    </record>
                                </field>
                        	</record>
                        	<record id="balance_sheet_line_02_01_02" model="account.report.line">
                        		<field name="name">Payables</field>
                                <field name="code">CL2</field>
                                <field name="groupby">account_id</field>
                               	<field name="expression_ids">
                               		<record id="balance_sheet_line_02_01_02_exp_01" model="account.report.expression">
                               			<field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula">
                                        	[('account_id.account_type', '=', 'liability_payable'), ('account_id.non_trade', '=', False)]</field>
                                        <field name="subformula">-sum</field>
                                        <field name="green_on_positive" eval="False"/>
                               		</record>
                               	</field>
                        	</record>
                        </field>
        			</record>
        			<record id="balance_sheet_line_02_02" model="account.report.line">
        				<field name="name">Plus Non-current Liabilities</field>
                        <field name="code">NL</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                        	<record id="balance_sheet_line_02_02_exp_01" model="account.report.expression">
                        		<field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('account_id.account_type', '=', 'liability_non_current')]</field>
                                <field name="subformula">-sum</field>
                                <field name="green_on_positive" eval="False"/>
                        	</record>
                        </field>
        			</record>
        		</field>
        	</record>
        	<record id="balance_sheet_line_03" model="account.report.line">
        		<field name="name">EQUITY</field>
        		<field name="code">EQ</field>
        		<field name="aggregation_formula">UNAFFECTED_EARNINGS.balance + RETAINED_EARNINGS.balance</field>
        		<field name="children_ids">
        			<record id="balance_sheet_line_03_01" model="account.report.line">
        				<field name="name">Unallocated Earnings</field>
                        <field name="code">UNAFFECTED_EARNINGS</field>
                        <field name="aggregation_formula">CURR_YEAR_EARNINGS.balance + PREV_YEAR_EARNINGS.balance</field>
                        <field name="children_ids">
                        	<record id="balance_sheet_line_03_01_01" model="account.report.line">
                        		<field name="name">Current Year Unallocated Earnings</field>
                                <field name="code">CURR_YEAR_EARNINGS</field>
                                <field name="aggregation_formula">CURR_YEAR_EARNINGS_PNL.balance + CURR_YEAR_EARNINGS_ALLOC.balance</field>
                                <field name="children_ids">
                                	<record id="balance_sheet_line_03_01_01_01" model="account.report.line">
                                		<field name="name">Current Year Earnings</field>
                                        <field name="code">CURR_YEAR_EARNINGS_PNL</field>
                                        <field name="expression_ids">
                                        	<record id="balance_sheet_line_03_01_01_01_exp_01" model="account.report.expression">
                                        		<field name="label">balance</field>
                                                <field name="engine">aggregation</field>
                                                <field name="formula">NEP.balance</field>
                                                <field name="date_scope">from_fiscalyear</field>
                                                <field name="subformula">cross_report</field>
                                        	</record>
                                        </field>
                                	</record>
                                	<record id="balance_sheet_line_03_01_01_02" model="account.report.line">
                                		<field name="name">Current Year Allocated Earnings</field>
                                        <field name="code">CURR_YEAR_EARNINGS_ALLOC</field>
                                        <field name="expression_ids">
                                        	<record id="balance_sheet_line_03_01_01_02_exp_01" model="account.report.expression">
                                        		<field name="label">balance</field>
                                                <field name="engine">domain</field>
                                                <field name="formula">[
                                                    ('account_id.account_type', '=', 'equity_unaffected'),
                                                    ('ctp_account_ids.account_type', '=', 'equity')
                                                ]</field>
                                                <field name="date_scope">from_fiscalyear</field>
                                                <field name="subformula">-sum</field>
                                        	</record>
                                        </field>
                                	</record>
                                </field>
                        	</record>
                        	<record id="balance_sheet_line_03_01_02" model="account.report.line">
                        		<field name="name">Previous Years Unallocated Earnings</field>
                                <field name="code">PREV_YEAR_EARNINGS</field>
                                <field name="expression_ids">
                                	<record id="balance_sheet_line_03_01_02_expr_02" model="account.report.expression">
                                		<field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula">[
                                        	('account_id.account_type', 'in', ('income', 'income_other', 'expense_direct_cost', 'expense', 'expense_depreciation')),
                                            ('ctp_account_ids.account_type', '!=', 'equity_unaffected')
                                        ]</field>
                                        <field name="subformula">-sum</field>
                                        <field name="date_scope">to_beginning_of_fiscalyear</field>
                                	</record>
                                </field>
                        	</record>
                        </field>
        			</record>
        			<record id="balance_sheet_line_03_02" model="account.report.line">
        				<field name="name">Retained Earnings</field>
                        <field name="code">RETAINED_EARNINGS</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="domain_formula">-sum([('account_id.account_type', '=', 'equity')])</field>
        			</record>
        		</field>
        	</record>
        	<record id="balance_sheet_line_04" model="account.report.line">
        		<field name="name">LIABILITIES + EQUITY</field>
        		<field name="code">LE</field>
        		<field name="expression_ids">
        			<record id="balance_sheet_line_04_expr_01" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">L.balance + EQ.balance</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
        		</field>
        	</record>
        	<record id="balance_sheet_line_05" model="account.report.line">
        		<field name="name">OFF BALANCE SHEET ACCOUNTS</field>
        		<field name="code">OS</field>
        		<field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="hide_if_zero" eval="True"/>
                <field name="domain_formula">-sum([('account_id.account_type', '=', 'off_balance')])</field>
        	</record>
        </field>
	</record>

</odoo>
