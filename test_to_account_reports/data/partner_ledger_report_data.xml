<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="partner_ledger_report" model="account.report">
		<field name="name">Partner Ledger</field>
		<field name="custom_line_python_function_suffix">partner_ledger</field>
		<field name="custom_line_name_template">PartnerLedgerReportLineName</field>
        <field name="load_more_limit" eval="80"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_account_type">payable_receivable</field>
        <field name="filter_partner" eval="True"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="column_ids">
        	<record id="partner_ledger_column_journal_code" model="account.report.column">
                <field name="name">Journal</field>
                <field name="expression_label">journal_code</field>
                <field name="figure_type">none</field>
                <field name="sequence">1</field>
            </record>
            <record id="partner_ledger_column_account_code" model="account.report.column">
                <field name="name">Account</field>
                <field name="expression_label">account_code</field>
                <field name="figure_type">none</field>
                <field name="sequence">2</field>
            </record>
            <record id="partner_ledger_column_ref" model="account.report.column">
                <field name="name">Ref</field>
                <field name="expression_label">ref</field>
                <field name="figure_type">none</field>
                <field name="sequence">3</field>
            </record>
            <record id="partner_ledger_column_invoice_date" model="account.report.column">
                <field name="name">Invoice Date</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
                <field name="sequence">4</field>
            </record>
            <record id="partner_ledger_column_date_maturity" model="account.report.column">
                <field name="name">Due Date</field>
                <field name="expression_label">date_maturity</field>
                <field name="figure_type">date</field>
                <field name="sequence">5</field>
            </record>
            <record id="partner_ledger_column_matching_number" model="account.report.column">
                <field name="name">Matching</field>
                <field name="expression_label">matching_number</field>
                <field name="figure_type">none</field>
                <field name="sequence">6</field>
            </record>
            <record id="partner_ledger_column_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="True"/>
                <field name="sequence">7</field>
            </record>
            <record id="partner_ledger_column_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="True"/>
                <field name="sequence">8</field>
            </record>
            <record id="partner_ledger_column_amount_currency" model="account.report.column">
                <field name="name">Amount Currency</field>
                <field name="expression_label">amount_currency</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="True"/>
                <field name="sequence">9</field>
            </record>
            <record id="partner_ledger_column_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="False"/>
                <field name="sequence">10</field>
            </record>
        </field>
	</record>

</odoo>
