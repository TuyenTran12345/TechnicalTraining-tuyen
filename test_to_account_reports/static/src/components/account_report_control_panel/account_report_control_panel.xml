<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

	<div t-name="to_account_reports.AccountReportControlPanel" owl="1">
		<ControlPanel display="controlPanelDisplay">

			<t t-set-slot="control-panel-bottom-left-buttons">
                <div class="o_cp_buttons">
                    <div class="o_list_buttons o_account_report_buttons">
                        <button type="button" class="btn btn-primary" t-on-click="() => props.onExport('pdf')">PDF</button>
                        <button type="button" class="btn btn-secondary ms-1" t-on-click="() => props.onExport('xlsx')">XLSX</button>
                    </div>
                </div>
            </t>

            <t t-set-slot="control-panel-bottom-right">
                <div class="o_search_options">
                	<AccountReportFilter
						reports="props.reports"
						currentReport="props.currentReport"
						journals="props.journals"
					 	filterOptions="props.filterOptions"
					 	changeReport.bind="props.changeReport"
					 	changeAccountType.bind="props.changeAccountType"
					 	selectUnpostedEntry.bind="props.selectUnpostedEntry"
					 	selectUnfoldAll.bind="props.selectUnfoldAll"
					 	changeDateFilter.bind="props.changeDateFilter"
					 	selectComparison.bind="props.selectComparison"
					 	updateMany2X.bind="props.updateMany2X"
					 	changeCustomStartDate.bind="props.changeCustomStartDate"
	 					changeCustomEndDate.bind="props.changeCustomEndDate"
					 	applyCustomDate.bind="props.applyCustomDate"
					 	changeComparisonStartDate.bind="props.changeComparisonStartDate"
	 					changeComparisonEndDate.bind="props.changeComparisonEndDate"
	 					applyComparisonDate.bind="props.applyComparisonDate"
						/>
                </div>
            </t>

		</ControlPanel>
	</div>

</templates>
