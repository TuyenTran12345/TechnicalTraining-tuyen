<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="account_report_expression_view_form" model="ir.ui.view">
        <field name="name">account.report.expression.view.form</field>
        <field name="model">account.report.expression</field>
        <field name="arch" type="xml">
        	<form>
            	<sheet>
            		<div class="oe_title">
                        <h1>
                            <field name="label" placeholder="Expression"/>
                        </h1>
                    </div>
                    <notebook>
                    	<page name="defination" string="Defination">
                    		<group>
                    			<field name="engine"/>
	                    		<field name="formula" attrs="{'invisible': [('engine', '=', ('domain'))]}"/>
	                    		<field name="formula" attrs="{'invisible': [('engine', '!=', ('domain'))]}"
	                    			widget="domain" options="{'model': 'account.move.line', 'in_dialog': True}"/>
	                    		<field name="subformula"/>
								<field name="use_reconcile" attrs="{'invisible': [('engine', '!=', ('domain'))]}"/>
								<field name="reconcile_domain" attrs="{'invisible': ['|', ('engine', '!=', ('domain')), ('use_reconcile', '=', False)]}"
									widget="domain" options="{'model': 'account.move.line', 'in_dialog': True}"/>
                    		</group>
                    	</page>
                    	<page name="option" string="Options">
                    		<group>
                    			<group>
	                    			<field name="date_scope"/>
		                    		<field name="figure_type"/>
	                    		</group>
	                    		<group>
	                    			<field name="blank_if_zero"/>
		                    		<field name="green_on_positive"/>
	                    		</group>
                    		</group>
                    	</page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
