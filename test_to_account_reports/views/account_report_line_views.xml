<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	
	<record id="account_report_line_view_form" model="ir.ui.view">
        <field name="name">account.report.line.view.form</field>
        <field name="model">account.report.line</field>
        <field name="arch" type="xml">
            <form>
            	<sheet>
            		<div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Report Line"/>
                        </h1>
                    </div>
                    <group>
                    	<group>
                    		<field name="parent_id"/>
                    		<field name="code"/>
                    		<field name="display_code"/>
                    		<field name="groupby"/>
                    		<field name="action_id"/>
                    		<field name="hierarchy_level"/>                    		
                    	</group>
                    	<group>
                    		<field name="show_on_print_document"/>
                    		<field name="has_empty_row"/>
                    		<field name="print_on_new_page"/>
                    		<field name="hide_if_zero"/>
                    	</group>
                    </group>
                    <notebook>
                    	<page name="expressions" string="Expressions">
                    		<field name="expression_ids">
                    			<tree>
                    				<field name="label"/>
	                                <field name="engine"/>
	                                <field name="formula"/>
	                                <field name="subformula"/>
                    			</tree>
                    		</field>
                    	</page>
                    </notebook>
            	</sheet>
            </form>
        </field>
    </record>

</odoo>
