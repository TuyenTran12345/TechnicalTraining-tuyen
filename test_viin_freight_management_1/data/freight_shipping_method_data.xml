<odoo noupdate="1">

    <record id="freight_shipping_method_fcl" model="freight.shipping.method">
        <field name="name">FCL</field>
        <field name="is_sea">True</field>
        <field name="is_land">True</field>
    </record>

    <record id="freight_shipping_method_ftl" model="freight.shipping.method">
        <field name="name">FTL</field>
        <field name="is_land">True</field>
    </record>

    <record id="freight_shipping_method_lcl" model="freight.shipping.method">
        <field name="name">LCL</field>
        <field name="is_sea">True</field>
        <field name="is_land">True</field>
    </record>

    <record id="freight_shipping_method_ltl" model="freight.shipping.method">
        <field name="name">LTL</field>
        <field name="is_land">True</field>
    </record>

    <record id="freight_shipping_method_bulk" model="freight.shipping.method">
        <field name="name">Bulk</field>
        <field name="is_sea">True</field>
        <field name="is_land">True</field>
    </record>

    <record id="freight_shipping_method_project_cargo" model="freight.shipping.method">
        <field name="name">Project Cargo</field>
