        <field name="name">Express</field>
        <field name="is_air">True</field>
    </record>

    <record id="freight_shipping_method_economy" model="freight.shipping.method">
        <field name="name">Economy</field>
        <field name="is_air">True</field>
    </record>

    <record id="freight_shipping_method_priority" model="freight.shipping.method">
        <field name="name">Priority</field>
        <field name="is_air">True</field>
    </record>

    <record id="freight_shipping_method_charter" model="freight.shipping.method">
        <field name="name">Charter</field>
        <field name="is_air">True</field>
    </record>

</odoo>
