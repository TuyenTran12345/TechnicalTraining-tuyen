<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Booking -->
        <record id="seq_freight_booking" model="ir.sequence">
            <field name="name">Freight Booking Sequence</field>
            <field name="code">freight.booking</field>
            <field name="prefix">BK-%(y)s%(month)s%(day)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Shipment -->
        <record id="seq_freight_shipment" model="ir.sequence">
            <field name="name">Freight Shipment Sequence</field>
            <field name="code">freight.shipment</field>
            <field name="prefix">SHP/%(y)s%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Freight Route -->
        <record id="seq_freight_route" model="ir.sequence">
            <field name="name">Freight Route Sequence</field>
            <field name="code">freight.route</field>
            <field name="prefix">RT/%(y)s%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
