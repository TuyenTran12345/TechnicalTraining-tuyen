<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Template for Shipment Tracking Updates -->
        <record id="email_template_shipment_tracking" model="mail.template">
            <field name="name">Freight: Shipment Tracking Update</field>
            <field name="model_id" ref="model_freight_shipment_tracking"/>
            <field name="subject">{{object.shipment_id.name}} Tracking Update</field>
            <field name="email_from">{{user.email_formatted}}</field>
            <field name="description">Sent to partners when a new tracking update is created</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px;">
                        Dear <t t-out="ctx.get('partner_name', 'Valued Customer')"/>,
                        <br/><br/>
                        We would like to inform you about a new tracking update for shipment <t t-out="object.shipment_id.name"/>.
                        <br/><br/>
                        <strong>Status:</strong> <t t-out="object.title_template_id.name"/><br/>
                        <strong>Time:</strong> <t t-out="format_datetime(object.event_time, tz=user.tz)"/><br/>
                        <strong>Location:</strong> <t t-out="object.location or ''"/><br/>
                        
                        <t t-if="object.stage_id">
                            <strong>Current Stage:</strong> <t t-out="object.stage_id.name"/><br/>
                        </t>
                        
                        <t t-if="object.details">
                            <strong>Additional Information:</strong><br/>
                            <t t-out="object.details"/>
                        </t>
                        
                        <t t-if="ctx.get('tracking_url')">
                            <br/><br/>
                            You can track your shipment online using this link:<br/>
                            <a t-att-href="ctx.get('tracking_url')" style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block; margin-top: 10px;">
                                View Tracking Details
                            </a>
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ctx.get('lang')}}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template for Carrier Resolution Notifications -->
        <record id="email_template_carrier_resolution" model="mail.template">
            <field name="name">Freight: Carrier Resolution Required</field>
            <field name="model_id" ref="model_freight_booking"/>
            <field name="subject">{{ctx.get('notification_subject', 'Carrier Resolution Required')}} - {{object.name}}</field>
            <field name="email_from">{{user.email_formatted}}</field>
            <field name="description">Sent to stakeholders when carrier resolution is needed</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34);">
                    <p style="margin: 8px 0px;">
                        Dear <t t-out="ctx.get('partner_name', 'Team Member')"/>,
                        <br/><br/>
                        <strong>Carrier Decision Required</strong>
                        <br/><br/>
                        A booking requires your attention regarding carrier configuration:
                        <br/><br/>
                        
                        <table style="border-collapse: collapse; border: 1px solid #ddd; width: 100%; margin: 10px 0;">
                            <tr style="background-color: #f2f2f2;">
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Shipment</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="object.shipment_id.name if object.shipment_id else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Booking</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="object.name"/></td>
                            </tr>
                            <tr style="background-color: #f2f2f2;">
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Current Carrier</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="object.carrier_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Company</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="object.company_id.partner_id.name if object.company_id else user.company_id.partner_id.name"/></td>
                            </tr>
                            <tr style="background-color: #f2f2f2;">
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Resolution Required</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;">
                                    <t t-if="object.carrier_resolution_required == 'update_po_vendor'">
                                        <span style="color: #f0ad4e;">Update PO Vendor</span>
                                    </t>
                                    <t t-elif="object.carrier_resolution_required == 'create_new_po'">
                                        <span style="color: #5cb85c;">Create New PO</span>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #5bc0de;">Manual Decision Required</span>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <t t-if="ctx.get('additional_message')">
                            <strong>Additional Information:</strong><br/>
                            <div style="background-color: #f9f9f9; padding: 10px; border-left: 4px solid #5bc0de; margin: 10px 0;">
                                <t t-out="ctx.get('additional_message')"/>
                            </div>
                        </t>

                        <strong>Action Required:</strong><br/>
                        Please review the booking and decide whether the company should handle the shipment internally or subcontract to the external carrier.
                        <br/><br/>

                        <a t-attf-href="/web#id={{object.id}}&amp;model=freight.booking&amp;view_type=form" 
                           style="background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block; margin-top: 15px;">
                            View Booking Details
                        </a>
                        <br/><br/>

                        Best regards,<br/>
                        <t t-out="user.name"/><br/>
                        <t t-out="user.company_id.name"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ctx.get('lang')}}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template for Shipment Carrier Resolution Notifications -->
        <record id="email_template_shipment_carrier_resolution" model="mail.template">
            <field name="name">Freight: Shipment Carrier Resolution Required</field>
            <field name="model_id" ref="model_freight_shipment"/>
            <field name="subject">{{ctx.get('notification_subject', 'Carrier Resolution Required')}} - {{object.name}}</field>
            <field name="email_from">{{user.email_formatted}}</field>
            <field name="description">Sent to stakeholders when carrier resolution is needed for shipment bookings</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34);">
                    <p style="margin: 8px 0px;">
                        Dear <t t-out="ctx.get('partner_name', 'Team Member')"/>,
                        <br/><br/>
                        <strong>Carrier Decision Required</strong>
                        <br/><br/>
                        A shipment booking requires your attention regarding carrier configuration:
                        <br/><br/>
                        
                        <table style="border-collapse: collapse; border: 1px solid #ddd; width: 100%; margin: 10px 0;">
                            <tr style="background-color: #f2f2f2;">
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Shipment</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="object.name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Booking</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="ctx.get('booking_name', 'N/A')"/></td>
                            </tr>
                            <tr style="background-color: #f2f2f2;">
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Current Carrier</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="ctx.get('carrier_name', 'N/A')"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Company</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="object.company_id.partner_id.name if object.company_id else user.company_id.partner_id.name"/></td>
                            </tr>
                            <tr style="background-color: #f2f2f2;">
                                <td style="border: 1px solid #ddd; padding: 8px;"><strong>Resolution Required</strong></td>
                                <td style="border: 1px solid #ddd; padding: 8px;">
                                    <t t-set="resolution" t-value="ctx.get('resolution_required', 'notify_only')"/>
                                    <t t-if="resolution == 'update_po_vendor'">
                                        <span style="color: #f0ad4e;">Update PO Vendor</span>
                                    </t>
                                    <t t-elif="resolution == 'create_new_po'">
                                        <span style="color: #5cb85c;">Create New PO</span>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #5bc0de;">Manual Decision Required</span>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <t t-if="ctx.get('additional_message')">
                            <strong>Additional Information:</strong><br/>
                            <div style="background-color: #f9f9f9; padding: 10px; border-left: 4px solid #5bc0de; margin: 10px 0;">
                                <t t-out="ctx.get('additional_message')"/>
                            </div>
                        </t>

                        <strong>Action Required:</strong><br/>
                        Please review the booking and decide whether the company should handle the shipment internally or subcontract to the external carrier.
                        <br/><br/>

                        <a t-attf-href="/web#id={{object.id}}&amp;model=freight.shipment&amp;view_type=form" 
                           style="background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block; margin-top: 15px;">
                            View Shipment Details
                        </a>
                        <br/><br/>

                        Best regards,<br/>
                        <t t-out="user.name"/><br/>
                        <t t-out="user.company_id.name"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ctx.get('lang')}}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>

    <template id="exception_sale_order_on_shipment_cancellation" name="Message: Alert on sale orders when shipment are cancelled">
        <div>
            <p>
                Exception(s) occurred on the shipment(s):
                <t t-foreach="shipments" t-as="shipment">
                    <a href="#" data-oe-model="freight.shipment" t-att-data-oe-id="shipment.id"><t t-esc="shipment.name"/></a>
                </t>.
            </p>
            <div class="mt16">
                <p>Exception(s):</p>
                <ul t-foreach="shipments" t-as="shipment">
                    <li>
                        Sale Order <a href="#" data-oe-model="freight.shipment" t-att-data-oe-id="shipment.id"><t t-esc="shipment.sale_order_id.name  "/></a>: cancelled
                    </li>
                </ul>
            </div>
        </div>
    </template>
</odoo>
