"\n"
"                        <t t-if=\"ctx.get('additional_message')\">\n"
"                            <strong>Additional Information:</strong><br>\n"
"                            <div style=\"background-color: #f9f9f9; padding: 10px; border-left: 4px solid #5bc0de; margin: 10px 0;\">\n"
"                                <t t-out=\"ctx.get('additional_message')\"></t>\n"
"                            </div>\n"
"                        </t>\n"
"\n"
"                        <strong>Action Required:</strong><br>\n"
"                        Please review the booking and decide whether the company should handle the shipment internally or subcontract to the external carrier.\n"
"                        <br><br>\n"
"\n"
"                        <a t-attf-href=\"/web#id={{object.id}}&amp;model=freight.shipment&amp;view_type=form\" style=\"background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block; margin-top: 15px;\">\n"
"                            View Shipment Details\n"
"                        </a>\n"
"                        <br><br>\n"
"\n"
"                        Best regards,<br>\n"
"                        <t t-out=\"user.name\"></t><br>\n"
"                        <t t-out=\"user.company_id.name\"></t>\n"
"                    </p>\n"
"                </div>\n"
"            "
