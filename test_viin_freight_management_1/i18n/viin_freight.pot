#. module: viin_freight_management
#: model:mail.template,body_html:viin_freight_management.email_template_carrier_resolution
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34);\">\n"
"                    <p style=\"margin: 8px 0px;\">\n"
"                        Dear <t t-out=\"ctx.get('partner_name', 'Team Member')\"></t>,\n"
"                        <br><br>\n"
"                        <strong>Carrier Decision Required</strong>\n"
"                        <br><br>\n"
"                        A booking requires your attention regarding carrier configuration:\n"
"                        <br><br>\n"
"                        \n"
"                        <table style=\"border-collapse: collapse; border: 1px solid #ddd; width: 100%; margin: 10px 0;\">\n"
"                            <tr style=\"background-color: #f2f2f2;\">\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Shipment</strong></td>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><t t-out=\"object.shipment_id.name if object.shipment_id else 'N/A'\"></t></td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Booking</strong></td>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><t t-out=\"object.name\"></t></td>\n"
"                            </tr>\n"
"                            <tr style=\"background-color: #f2f2f2;\">\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Current Carrier</strong></td>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><t t-out=\"object.carrier_id.name\"></t></td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Company</strong></td>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><t t-out=\"object.company_id.partner_id.name if object.company_id else user.company_id.partner_id.name\"></t></td>\n"
"                            </tr>\n"
"                            <tr style=\"background-color: #f2f2f2;\">\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Resolution Required</strong></td>\n"
"                                <td style=\"border: 1px solid #ddd; padding: 8px;\">\n"
"                                    <t t-if=\"object.carrier_resolution_required == 'update_po_vendor'\">\n"
"                                        <span style=\"color: #f0ad4e;\">Update PO Vendor</span>\n"
"                                    </t>\n"
"                                    <t t-elif=\"object.carrier_resolution_required == 'create_new_po'\">\n"
"                                        <span style=\"color: #5cb85c;\">Create New PO</span>\n"
"                                    </t>\n"
"                                    <t t-else=\"\">\n"
"                                        <span style=\"color: #5bc0de;\">Manual Decision Required</span>\n"
"                                    </t>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"\n"
"                        <t t-if=\"ctx.get('additional_message')\">\n"
"                            <strong>Additional Information:</strong><br>\n"
"                            <div style=\"background-color: #f9f9f9; padding: 10px; border-left: 4px solid #5bc0de; margin: 10px 0;\">\n"
"                                <t t-out=\"ctx.get('additional_message')\"></t>\n"
"                            </div>\n"
"                        </t>\n"
"\n"
"                        <strong>Action Required:</strong><br>\n"
"                        Please review the booking and decide whether the company should handle the shipment internally or subcontract to the external carrier.\n"
"                        <br><br>\n"
"\n"
"                        <a t-attf-href=\"/web#id={{object.id}}&amp;model=freight.booking&amp;view_type=form\" style=\"background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block; margin-top: 15px;\">\n"
"                            View Booking Details\n"
"                        </a>\n"
"                        <br><br>\n"
"\n"
"                        Best regards,<br>\n"
"                        <t t-out=\"user.name\"></t><br>\n"
"                        <t t-out=\"user.company_id.name\"></t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: viin_freight_management
#: model:mail.template,body_html:viin_freight_management.email_template_shipment_carrier_resolution
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34);\">\n"
