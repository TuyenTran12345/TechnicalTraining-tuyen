#. module: viin_freight_management
#: model:mail.template,body_html:viin_freight_management.email_template_shipment_tracking
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px;\">\n"
"                        Dear <t t-out=\"ctx.get('partner_name', 'Valued Customer')\"></t>,\n"
"                        <br><br>\n"
"                        We would like to inform you about a new tracking update for shipment <t t-out=\"object.shipment_id.name\"></t>.\n"
"                        <br><br>\n"
"                        <strong>Status:</strong> <t t-out=\"object.title_template_id.name\"></t><br>\n"
"                        <strong>Time:</strong> <t t-out=\"format_datetime(object.event_time, tz=user.tz)\"></t><br>\n"
"                        <strong>Location:</strong> <t t-out=\"object.location or ''\"></t><br>\n"
"                        \n"
"                        <t t-if=\"object.stage_id\">\n"
"                            <strong>Current Stage:</strong> <t t-out=\"object.stage_id.name\"></t><br>\n"
"                        </t>\n"
"                        \n"
"                        <t t-if=\"object.details\">\n"
"                            <strong>Additional Information:</strong><br>\n"
"                            <t t-out=\"object.details\"></t>\n"
"                        </t>\n"
"                        \n"
"                        <t t-if=\"ctx.get('tracking_url')\">\n"
"                            <br><br>\n"
"                            You can track your shipment online using this link:<br>\n"
"                            <a t-att-href=\"ctx.get('tracking_url')\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block; margin-top: 10px;\">\n"
"                                View Tracking Details\n"
"                            </a>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

