<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Freight Security Groups -->
        <record id="base.module_category_operations_logistics" model="ir.module.category">
            <field name="name">Logistics</field>
            <field name="description">Helps you manage your freight operations</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_freight_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="base.module_category_operations_logistics"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_freight_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="base.module_category_operations_logistics"/>
            <field name="implied_ids" eval="[(4, ref('group_freight_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <!-- Rules -->
    <data>
        <record id="freight_shipment_portal_rule" model="ir.rule">
            <field name="name">Freight Shipment Portal</field>
            <field name="model_id" ref="model_freight_shipment"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|', '|',
                ('customer_id', '=', user.partner_id.id),
                ('consignee_id', '=', user.partner_id.id),
                ('shipper_id', '=', user.partner_id.id),
                ('notify_party_id', '=', user.partner_id.id),
                ('carrier_id', '=', user.partner_id.id),
                ('agent_id', '=', user.partner_id.id),
                ('message_partner_ids', 'child_of', user.partner_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="freight_shipment_tracking_portal_rule" model="ir.rule">
            <field name="name">Freight Shipment Tracking Portal</field>
            <field name="model_id" ref="model_freight_shipment_tracking"/>
            <field name="domain_force">[
                ('shipment_id.customer_id', '=', user.partner_id.id),
                ('shipment_id.consignee_id', '=', user.partner_id.id),
                ('shipment_id.shipper_id', '=', user.partner_id.id),
                ('shipment_id.notify_party_id', '=', user.partner_id.id),
                ('shipment_id.carrier_id', '=', user.partner_id.id),
                ('shipment_id.agent_id', '=', user.partner_id.id),
                ('shipment_id.message_partner_ids', 'child_of', user.partner_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="freight_shipment_cargo_template_portal_rule" model="ir.rule">
            <field name="name">Freight Shipment Cargo Template Portal</field>
            <field name="model_id" ref="model_cargo_template"/>
            <field name="domain_force">[
                ('shipment_id.customer_id', '=', user.partner_id.id),
                ('shipment_id.consignee_id', '=', user.partner_id.id),
                ('shipment_id.shipper_id', '=', user.partner_id.id),
                ('shipment_id.notify_party_id', '=', user.partner_id.id),
                ('shipment_id.carrier_id', '=', user.partner_id.id),
                ('shipment_id.agent_id', '=', user.partner_id.id),
                ('shipment_id.message_partner_ids', 'child_of', user.partner_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="freight_package_freight_user_rule" model="ir.rule">
            <field name="name">Freight Package Freight User</field>
            <field name="model_id" ref="model_freight_package"/>
            <field name="domain_force">[
                '|',
                ('shipment_id.responsible_id', 'in', [user.id, False]),
                ('shipment_id', '=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('group_freight_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_create" eval="True"/>
        </record>

        <record id="freight_cargo_commodity_portal_rule" model="ir.rule">
