<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="viin_freight_management.ShipmentProfitabilityHeader" owl="1">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                <button class="btn btn-link p-0 text-decoration-none"
                    t-on-click="() => openRecord('freight.shipment', props.data.shipment_id)">
                    <i class="fa fa-ship me-1"/>
                    <t t-esc="props.data.shipment_name"/>
                </button>
            </h5>
            <div class="btn-group">
                <button t-if="props.data.sale_order_id"
                    class="btn btn-sm btn-secondary"
                    t-on-click="() => openRecord('sale.order', props.data.sale_order_id)">
                    <i class="fa fa-book me-1"/>
                    <t t-esc="props.data.sale_order_name"/>
                </button>
                <button t-if="props.data.booking_count > 0"
                    class="btn btn-sm btn-secondary"
                    t-on-click="props.openBookings">
                    <i class="fa fa-ticket me-1"/>
                    <span>Bookings</span>
                    <span class="badge text-bg-light rounded-pill ms-1" t-esc="props.data.booking_count"/>
                </button>
                <button t-if="props.data.sale_order_line_ids"
                    class="btn btn-sm btn-secondary"
                    t-on-click="props.openSaleOrderLines">
                    <i class="fa fa-list-alt me-1"/>
                    <span>Sale Item</span>
                </button>
            </div>
        </div>
    </t>

</templates>
