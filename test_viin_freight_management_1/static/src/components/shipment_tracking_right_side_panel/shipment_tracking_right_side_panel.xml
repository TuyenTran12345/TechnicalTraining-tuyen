<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="viin_freight_management.ShipmentTrackingRightSidePanel" owl="1">
        <div t-if="shipmentId" class="o_shipment_tracking_rightpanel p-2">
            <div t-if="state.isLoading" class="o_loading_indicator"/>
            <t t-else="">
                <ShipmentProfitabilityHeader
                    data="state.panelData"
                    openRecord="(params) => this.openRecord(params)"
                    openSaleOrderLines="() => this.openSaleOrderLines()"
                    openBookings="() => this.openBookings()"/>
                <ShipmentRightSidePanelSection name="'profitability'">
                    <t t-set-slot="title">
                        Profitability
                    </t>
                    <ShipmentProfitability
                        data="state.panelData.profitability_items"
                        currencyId="state.panelData.currency_id"/>
                </ShipmentRightSidePanelSection>
                <ShipmentRightSidePanelSection name="'on_behalf'" show="state.panelData.on_behalf_items and state.panelData.on_behalf_items.data.length > 0">
                    <ShipmentOnBehalf
                        data="state.panelData.on_behalf_items"
                        currencyId="state.panelData.currency_id"
                        currencyDecimalPlaces="state.panelData.currency_decimal_places"/>
                </ShipmentRightSidePanelSection>
            </t>
        </div>
    </t>

</templates>
