<odoo>
    <!-- Tree View -->
    <record id="cargo_template_data_tree_view" model="ir.ui.view">
        <field name="name">cargo.template.data.tree.view</field>
        <field name="model">freight.cargo.template.data</field>
        <field name="arch" type="xml">
            <tree string="Cargo Template Data">
                <field name="name"/>
                <field name="packing_mode"/>
                <field name="package_type_id"/>
                <field name="cargo_type_id"/>
                <field name="total_weight"/>
                <field name="total_volume"/>
                <field name="weight_uom_name" invisible="1"/>
                <field name="volume_uom_name" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="cargo_template_data_form_view" model="ir.ui.view">
        <field name="name">cargo.template.data.form.view</field>
        <field name="model">freight.cargo.template.data</field>
        <field name="arch" type="xml">
            <form string="Cargo Template Data">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="eg. 1000kg of Steel"/>
                            <field name="packing_mode"/>
                            <field name="package_type_id" attrs="{
                                'invisible': [('packing_mode', '=', 'bulk')],
                                'required': [('packing_mode', '!=', 'bulk')]
                            }"/>
                        </group>
                        <group>
                            <label for="volume" string="Volume"/>
                            <div class="o_row">
                                <field name="volume"/>
                                <field name="volume_uom_name"/>
                            </div>
                            <label for="weight" string="Weight" attrs="{
                                'invisible': [('packing_mode', '=', 'package')]}"/>
                            <div class="o_row" attrs="{
                                'invisible': [('packing_mode', '=', 'package')]}">
                                <field name="weight"/>
                                <field name="weight_uom_name"/>
                            </div>
                            <label for="total_volume" string="Total Volume"/>
                            <div class="o_row">
                                <field name="total_volume"/>
                                <field name="volume_uom_name"/>
                            </div>
                            <label for="total_weight" string="Total Weight"/>
                            <div class="o_row">
                                <field name="total_weight"/>
                                <field name="weight_uom_name"/>
                            </div>
                        </group>
                    </group>
                    <group string="Cargo Information" name="cargo_info" attrs="{
                        'invisible': [('packing_mode', '!=', 'bulk')]
                    }">
                        <group>
                            <field name="cargo_type_id"/>
                            <field name="hs_code_id"/>
                            <field name="country_of_origin_id"/>
                            <field name="import_tax_rate"
                                attrs="{'invisible': ['|', ('hs_code_id', '=', False), ('country_of_origin_id', '=', False)]}"/>
                            <field name="need_marking"/>    
                        </group>
                        <group>
                            <field name="is_danger"/>
                            <field name="dg_class_id" attrs="{'invisible': [('is_danger', '=', False)]}"/>
                            <field name="un_number_id" options="{'no_create': True}"
                                domain="[('dg_class_id', '=', dg_class_id)]"
                                attrs="{'invisible': [('is_danger', '=', False)]}"/>
                            <field name="packaging_group" attrs="{'invisible': [('is_danger', '=', False)]}"/>
                            <field name="flash_point" attrs="{'invisible': [('is_danger', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Handling Instructions" name="handling_instructions" attrs="{
                            'invisible': [('packing_mode', '!=', 'bulk')]
                        }">
                            <field name="handling_instructions"/>
                        </page>
                        <page string="Cargo Template Data Lines" name="cargo_template_data_lines" attrs="{
                            'invisible': [('packing_mode', '!=', 'package')]
                        }">
                            <field name="cargo_template_data_line_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="cargo_template_data_search_view" model="ir.ui.view">
        <field name="name">cargo.template.data.search.view</field>
        <field name="model">freight.cargo.template.data</field>
        <field name="arch" type="xml">
            <search string="Search Cargo Template Data">
                <field name="name"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Package Type" name="grp_package_type" context="{'group_by': 'package_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_freight_cargo_template_data" model="ir.actions.act_window">
        <field name="name">Cargo Template Data</field>
        <field name="res_model">freight.cargo.template.data</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="cargo_template_data_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                You'll need to define a cargo template before it can be used in a shipment
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="freight_menu_config_cargo_template_data"
        name="Cargo Template Data" action="action_freight_cargo_template_data"
        parent="freight_menu_config_cargo_info"
        sequence="5" groups="viin_freight_management.group_freight_manager"/>
</odoo>
