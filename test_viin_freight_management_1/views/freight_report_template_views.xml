<odoo>

    <!-- House Bill of Lading Report Template -->
    <template id="report_hbl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header Section -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2 style="margin-bottom: 5px;">
                                    <strong>
                                        <t t-if="o.company_id.name">
                                            <span t-field="o.company_id.name"/>
                                        </t>
                                    </strong>
                                </h2>
                                <h4 style="margin-top: 0px;">Bill of Lading for Ocean Transport or Multi-Modal Transport</h4>
                            </div>
                        </div>

                        <!-- Main Information Grid -->
                        <table class="table table-bordered mb-0" style="border: 2px solid black;">
                            <tbody>
                                <!-- Shipper Information -->
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding: 10px; border-right: 2px solid black;">
                                        <strong>Shipper (full style and address)</strong>
                                        <div t-if="o.shipper_id">
                                            <div t-field="o.shipper_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                                        </div>
                                    </td>
                                    <td style="width: 50%; vertical-align: top; padding: 10px;">
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <strong>B/L No.</strong>
                                                <div>
                                                    <span t-field="o.house_bill_number"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <strong>Reference No.</strong>
                                                <div>
                                                    <span t-field="o.name"/>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Consignee Information -->
                                <tr>
                                    <td style="vertical-align: top; padding: 10px; border-right: 2px solid black;">
                                        <strong>Consignee (full style and address) or Order</strong>
                                        <div t-if="o.consignee_id">
                                            <div t-field="o.consignee_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                                        </div>
                                        <div t-else="">
                                            <span>To order of Shipper</span>
                                        </div>
                                    </td>
                                    <td style="vertical-align: top; padding: 10px;">
                                        <strong>Vessel</strong>
                                        <div>
                                            <span t-field="o.vessel_name"/>
                                            <t t-if="o.vessel_voyage_number">
                                                <span t-field="o.vessel_voyage_number"/>
                                            </t>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Notify Party Information -->
                                <tr>
                                    <td style="vertical-align: top; padding: 10px; border-right: 2px solid black;">
                                        <strong>Notify Party (full style and address)</strong>
                                        <div t-if="o.notify_party_id">
                                            <div t-field="o.notify_party_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                                        </div>
                                    </td>
                                    <td style="vertical-align: top; padding: 10px;">
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <strong>Port of loading</strong>
                                                <div>
                                                    <span t-if="o.port_of_loading_id" t-field="o.port_of_loading_id.name"/>
                                                    <span t-else="" t-field="o.origin_id.name"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <strong>Port of discharge</strong>
                                                <div>
                                                    <span t-if="o.port_of_discharge_id" t-field="o.port_of_discharge_id.name"/>
                                                    <span t-else="" t-field="o.destination_id.name"/>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Particulars Section -->
                        <div class="mt-3">
                            <h5 style="background-color: #e0e0e0; padding: 8px; margin-bottom: 0;">
                                PARTICULARS DECLARED BY THE SHIPPER BUT NOT ACKNOWLEDGED BY THE CARRIER
                            </h5>
                            <table class="table table-bordered mb-0" style="border: 2px solid black;">
                                <thead>
                                    <tr style="background-color: #f0f0f0;">
                                        <th style="width: 25%; padding: 8px;">Container No./Seal No./Marks and Numbers</th>
                                        <th style="width: 35%; padding: 8px;">Number and kind of packages; description of cargo</th>
                                        <th style="width: 20%; padding: 8px;">Gross weight, kg</th>
                                        <th style="width: 20%; padding: 8px;">Measurement, m3</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Case 1: Packages with potential cargo commodities inside -->
                                    <t t-if="o.package_ids">
                                        <t t-foreach="o.package_ids" t-as="package">
                                            <!-- Package Header Row -->
                                            <tr style="background-color: #fafafa;">
                                                <td style="padding: 8px; vertical-align: top;">
                                                    <strong>
                                                        <span t-if="package.container_number" t-field="package.container_number"/>
                                                        <span t-else="" t-field="package.name"/>
                                                    </strong>
                                                    <t t-if="package.seal_number">
                                                        <br/><small>Seal: <span t-field="package.seal_number"/></small>
                                                    </t>
                                                    <t t-if="package.shipping_mark">
                                                        <br/><small><span t-field="package.shipping_mark"/></small>
                                                    </t>
                                                </td>
                                                <td style="padding: 8px; vertical-align: top;">
                                                    <strong><span t-field="package.package_type_id.name"/></strong>
                                                    <t t-if="package.handling_instructions">
                                                        <br/><small class="text-danger">⚠ <span t-field="package.handling_instructions"/></small>
                                                    </t>
                                                </td>
                                                <td style="padding: 8px; text-align: right; vertical-align: top;">
                                                    <strong>
                                                        <span t-field="package.weight" t-options='{"widget": "float", "precision": 2}'/>
                                                        <span t-field="o.weight_uom_name"/>
                                                    </strong>
                                                </td>
                                                <td style="padding: 8px; text-align: right; vertical-align: top;">
                                                    <strong>
                                                        <span t-field="package.volume" t-options='{"widget": "float", "precision": 2}'/>
                                                        <span t-field="o.volume_uom_name"/>
                                                    </strong>
                                                </td>
                                            </tr>
                                            
                                            <!-- Cargo Commodities inside this package -->
                                            <t t-if="package.cargo_commodity_ids">
                                                <tr t-foreach="package.cargo_commodity_ids" t-as="cargo" style="border-left: 3px solid #007bff;">
                                                    <td style="padding: 4px 4px 4px 16px; font-size: 0.9em;">
                                                        <t t-if="cargo.shipping_mark">
                                                            <span t-field="cargo.shipping_mark"/>
                                                        </t>
                                                        <t t-if="cargo.is_danger">
                                                            <br/><span class="badge bg-danger">⚠ DANGEROUS GOODS</span>
                                                            <t t-if="cargo.un_number_id">
                                                                <br/><small>UN <span t-field="cargo.un_number_id"/></small>
                                                            </t>
                                                        </t>
                                                    </td>
                                                    <td style="padding: 4px 8px; font-size: 0.9em;">
                                                        <span t-field="cargo.quantity"/> <span t-if="cargo.package_type_id" t-field="cargo.package_type_id.name"/>
                                                        <span t-else="" t-field="cargo.uom_id.name"/>
                                                        - <span t-field="cargo.name"/>
                                                        <t t-if="cargo.hs_code_id">
                                                            <br/><small>HS Code: <span t-field="cargo.hs_code_id"/></small>
                                                        </t>
                                                        <t t-if="cargo.handling_instructions">
                                                            <br/><small class="text-danger">⚠ <span t-field="cargo.handling_instructions"/></small>
                                                        </t>
                                                    </td>
                                                    <td style="padding: 4px 8px; text-align: right; font-size: 0.9em;">
                                                        <span t-field="cargo.weight" t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                    <td style="padding: 4px 8px; text-align: right; font-size: 0.9em;">
                                                        <span t-field="cargo.volume" t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                            
                                            <!-- Cargo Note Details for package (if no cargo commodities) -->
                                            <t t-elif="package.cargo_note_details">
                                                <tr>
                                                    <td colspan="4" style="padding: 4px 4px 4px 16px; font-size: 0.9em; font-style: italic;">
                                                        <span t-field="package.cargo_note_details"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                    
                                    <!-- Case 2: Cargo commodities without packages (bulk cargo) -->
                                    <t t-elif="o.cargo_commodity_ids">
                                        <tr t-foreach="o.cargo_commodity_ids" t-as="cargo">
                                            <td style="padding: 8px;">
                                                <t t-if="cargo.shipping_mark">
                                                    <span t-field="cargo.shipping_mark"/>
                                                </t>
                                                <t t-if="cargo.is_danger">
                                                    <br/><span class="badge bg-danger">⚠ DANGEROUS GOODS</span>
                                                    <t t-if="cargo.un_number_id">
                                                        <br/><small>UN <span t-field="cargo.un_number_id"/></small>
                                                    </t>
                                                    <t t-if="cargo.dg_class_id">
                                                        <br/><small>Class <span t-field="cargo.dg_class_id"/></small>
                                                    </t>
                                                </t>
                                            </td>
                                            <td style="padding: 8px;">
                                                <span t-field="cargo.quantity"/> 
                                                <span t-if="cargo.package_type_id" t-field="cargo.package_type_id.name"/>
                                                <span t-else="" t-field="cargo.uom_id.name"/>
                                                - <span t-field="cargo.name"/>
                                                <t t-if="cargo.hs_code_id">
                                                    <br/><small>HS Code: <span t-field="cargo.hs_code_id"/></small>
                                                </t>
                                                <t t-if="cargo.country_of_origin_id">
                                                    <br/><small>Origin: <span t-field="cargo.country_of_origin_id.name"/></small>
                                                </t>
                                                <t t-if="cargo.handling_instructions">
                                                    <br/><small class="text-danger">⚠ <span t-field="cargo.handling_instructions"/></small>
                                                </t>
                                            </td>
                                            <td style="padding: 8px; text-align: right;">
                                                <span t-field="cargo.weight" t-options='{"widget": "float", "precision": 2}'/>
                                                <span t-field="o.weight_uom_name"/>
                                            </td>
                                            <td style="padding: 8px; text-align: right;">
                                                <span t-field="cargo.volume" t-options='{"widget": "float", "precision": 2}'/>
                                                <span t-field="o.volume_uom_name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    
                                    <!-- Case 3: Only cargo note details (simple mode) -->
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" style="padding: 12px;">
                                                <span t-field="o.cargo_note_details"/>
                                            </td>
                                        </tr>
                                    </t>
                                    
                                    <!-- Totals Row -->
                                    <tr style="font-weight: bold; background-color: #f8f8f8;">
                                        <td style="padding: 8px;">
                                            Total: <span t-esc="len(o.package_ids) if o.package_ids else len(o.cargo_commodity_ids)"/> 
                                            <span t-if="o.package_ids">Package(s)</span>
                                            <span t-elif="o.cargo_commodity_ids">Item(s)</span>
                                        </td>
                                        <td style="padding: 8px;">
                                            <t t-if="o.cargo_commodity_ids or (o.package_ids and any(p.cargo_commodity_ids for p in o.package_ids))">
                                                Total Cargo: <span t-field="o.total_cargo_commodities"/>
                                            </t>
                                        </td>
                                        <td style="padding: 8px; text-align: right;">
                                            <span t-field="o.total_weight" t-options='{"widget": "float", "precision": 2}'/>
                                            <span t-field="o.weight_uom_name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: right;">
                                            <span t-field="o.total_volume" t-options='{"widget": "float", "precision": 2}'/>
                                            <span t-field="o.volume_uom_name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Additional Information -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <div><strong>Service Type:</strong> <span t-field="o.service_type"/></div>
                                <div><strong>Transport Mode:</strong> <span t-field="o.transport_mode"/></div>
                                <div t-if="o.incoterm_id"><strong>Incoterm:</strong> <span t-field="o.incoterm_id.name"/></div>
                            </div>
                            <div class="col-6">
                                <div t-if="o.etd"><strong>ETD:</strong> <span t-field="o.etd" t-options='{"widget": "datetime"}'/></div>
                                <div t-if="o.eta"><strong>ETA:</strong> <span t-field="o.eta" t-options='{"widget": "datetime"}'/></div>
                                <div t-if="o.cutoff"><strong>Cutoff:</strong> <span t-field="o.cutoff" t-options='{"widget": "datetime"}'/></div>
                            </div>
                        </div>

                        <!-- Notes Section -->
                        <div class="mt-3" t-if="o.description">
                            <strong>Additional Notes:</strong>
                            <div t-field="o.description"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Booking Request Report Template -->
    <template id="report_bk_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header Section -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h3>
                                    <t t-if="o.company_id.name">
                                        <span t-field="o.company_id.name"/>
                                    </t>
                                </h3>
                            </div>
                            <div class="col-6 text-right">
                                <h3>Customer Booking Request Form</h3>
                            </div>
                        </div>

                        <!-- Main Information Table -->
                        <table class="table table-bordered">
                            <tbody>
                                <!-- Example Section -->
                                <tr style="background-color: #f8f8f8;">
                                    <td colspan="2" style="padding: 10px;">
                                        <strong>Example</strong>
                                        <div t-if="o.destination_id">
                                            Travelling to: <span t-field="o.destination_id.name"/>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Customer Information -->
                                <tr>
                                    <td style="width: 40%; padding: 10px;"><strong>Name:</strong></td>
                                    <td style="width: 60%; padding: 10px;">
                                        <span t-if="o.customer_id" t-field="o.customer_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Contact phone number:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.customer_id" t-field="o.customer_id.phone"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Best day to call:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-field="o.booking_date" t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Number of packages:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-field="o.total_packages"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Date of outward journey:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.etd" t-field="o.etd" t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Day of return journey:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.eta" t-field="o.eta" t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Purpose of trip:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-field="o.service_type"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Special requirements:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-field="o.description"/>
                                    </td>
                                </tr>

                                <!-- Market Research Section -->
                                <tr style="background-color: #f8f8f8;">
                                    <td colspan="2" style="padding: 10px;">
                                        <strong>Market Research</strong>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Booking Reference:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-field="o.booking_ref"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Origin:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.origin_id" t-field="o.origin_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Destination:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.destination_id" t-field="o.destination_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Transport Mode:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-field="o.transport_mode"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Carrier:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.carrier_id" t-field="o.carrier_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Email address:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.customer_id" t-field="o.customer_id.email"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding: 10px;"><strong>Responsible:</strong></td>
                                    <td style="padding: 10px;">
                                        <span t-if="o.responsible_id" t-field="o.responsible_id.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Cargo Details Section -->
                        <div class="mt-4" t-if="o.package_ids or o.cargo_commodity_ids or o.cargo_note_details">
                            <h5>Cargo Details</h5>
                            <table class="table table-bordered">
                                <thead style="background-color: #f0f0f0;">
                                    <tr>
                                        <th style="width: 40%; padding: 8px;">Description</th>
                                        <th style="width: 20%; padding: 8px; text-align: right;">Quantity/Packages</th>
                                        <th style="width: 20%; padding: 8px; text-align: right;">Weight (<span t-field="o.weight_uom_name"/>)</th>
                                        <th style="width: 20%; padding: 8px; text-align: right;">Volume (<span t-field="o.volume_uom_name"/>)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Case 1: Packages with potential cargo commodities inside -->
                                    <t t-if="o.package_ids">
                                        <t t-foreach="o.package_ids" t-as="package">
                                            <!-- Package Row -->
                                            <tr style="background-color: #fafafa;">
                                                <td style="padding: 8px;">
                                                    <strong><span t-field="package.package_type_id.name"/></strong>
                                                    <t t-if="package.container_number">
                                                        - <span t-field="package.container_number"/>
                                                    </t>
                                                    <t t-else="">
                                                        - <span t-field="package.name"/>
                                                    </t>
                                                    <t t-if="package.handling_instructions">
                                                        <br/><small class="text-danger">⚠ <span t-field="package.handling_instructions"/></small>
                                                    </t>
                                                </td>
                                                <td style="padding: 8px; text-align: right;">
                                                    <strong>1</strong>
                                                </td>
                                                <td style="padding: 8px; text-align: right;">
                                                    <strong><span t-field="package.weight" t-options='{"widget": "float", "precision": 2}'/></strong>
                                                </td>
                                                <td style="padding: 8px; text-align: right;">
                                                    <strong><span t-field="package.volume" t-options='{"widget": "float", "precision": 2}'/></strong>
                                                </td>
                                            </tr>
                                            
                                            <!-- Cargo Commodities inside this package -->
                                            <t t-if="package.cargo_commodity_ids">
                                                <tr t-foreach="package.cargo_commodity_ids" t-as="cargo">
                                                    <td style="padding: 4px 4px 4px 24px; font-size: 0.9em;">
                                                        <span t-field="cargo.name"/>
                                                        <t t-if="cargo.is_danger">
                                                            <span class="badge bg-danger ms-2">⚠ DG</span>
                                                        </t>
                                                        <t t-if="cargo.handling_instructions">
                                                            <br/><small class="text-danger">⚠ <span t-field="cargo.handling_instructions"/></small>
                                                        </t>
                                                    </td>
                                                    <td style="padding: 4px 8px; text-align: right; font-size: 0.9em;">
                                                        <span t-field="cargo.quantity"/>
                                                        <span t-if="cargo.package_type_id" t-field="cargo.package_type_id.name"/>
                                                        <span t-else="" t-field="cargo.uom_id.name"/>
                                                    </td>
                                                    <td style="padding: 4px 8px; text-align: right; font-size: 0.9em;">
                                                        <span t-field="cargo.weight" t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                    <td style="padding: 4px 8px; text-align: right; font-size: 0.9em;">
                                                        <span t-field="cargo.volume" t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                            
                                            <!-- Cargo Note for package -->
                                            <t t-elif="package.cargo_note_details">
                                                <tr>
                                                    <td colspan="4" style="padding: 4px 4px 4px 24px; font-size: 0.9em; font-style: italic;">
                                                        <span t-field="package.cargo_note_details"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                    
                                    <!-- Case 2: Cargo commodities without packages (bulk cargo) -->
                                    <t t-elif="o.cargo_commodity_ids">
                                        <tr t-foreach="o.cargo_commodity_ids" t-as="cargo">
                                            <td style="padding: 8px;">
                                                <span t-field="cargo.name"/>
                                                <t t-if="cargo.is_danger">
                                                    <span class="badge bg-danger ms-2">⚠ DANGEROUS GOODS</span>
                                                    <t t-if="cargo.un_number_id">
                                                        <br/><small>UN <span t-field="cargo.un_number_id"/></small>
                                                    </t>
                                                </t>
                                                <t t-if="cargo.hs_code_id">
                                                    <br/><small>HS: <span t-field="cargo.hs_code_id"/></small>
                                                </t>
                                                <t t-if="cargo.handling_instructions">
                                                    <br/><small class="text-danger">⚠ <span t-field="cargo.handling_instructions"/></small>
                                                </t>
                                            </td>
                                            <td style="padding: 8px; text-align: right;">
                                                <span t-field="cargo.quantity"/>
                                                <span t-if="cargo.package_type_id" t-field="cargo.package_type_id.name"/>
                                                <span t-else="" t-field="cargo.uom_id.name"/>
                                            </td>
                                            <td style="padding: 8px; text-align: right;">
                                                <span t-field="cargo.weight" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td style="padding: 8px; text-align: right;">
                                                <span t-field="cargo.volume" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    
                                    <!-- Case 3: Only cargo note details (simple mode) -->
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" style="padding: 8px;">
                                                <span t-field="o.cargo_note_details"/>
                                            </td>
                                        </tr>
                                    </t>
                                    
                                    <!-- Totals Row -->
                                    <tr style="font-weight: bold; background-color: #f8f8f8;">
                                        <td style="padding: 8px;">
                                            Total
                                            <t t-if="o.cargo_commodity_ids or (o.package_ids and any(p.cargo_commodity_ids for p in o.package_ids))">
                                                (<span t-field="o.total_cargo_commodities"/> items)
                                            </t>
                                        </td>
                                        <td style="padding: 8px; text-align: right;">
                                            <span t-field="o.total_packages"/> pkg(s)
                                        </td>
                                        <td style="padding: 8px; text-align: right;">
                                            <span t-field="o.total_weight" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                        <td style="padding: 8px; text-align: right;">
                                            <span t-field="o.total_volume" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Additional Notes -->
                        <div class="mt-3" t-if="o.description">
                            <strong>Additional Notes:</strong>
                            <div t-field="o.description"/>
                        </div>

                        <!-- Footer Information -->
                        <div class="row mt-4" style="border-top: 2px solid #333; padding-top: 10px;">
                            <div class="col-6">
                                <div><strong>Booking No:</strong> <span t-field="o.name"/></div>
                                <div><strong>Status:</strong> <span t-field="o.state"/></div>
                            </div>
                            <div class="col-6 text-right">
                                <div><strong>Booking Date:</strong> <span t-field="o.booking_date" t-options='{"widget": "date"}'/></div>
                                <div t-if="o.cutoff"><strong>Cutoff:</strong> <span t-field="o.cutoff" t-options='{"widget": "datetime"}'/></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
