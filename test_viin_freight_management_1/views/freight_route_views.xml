<odoo>

    <record id="freight_route_view_form" model="ir.ui.view">
        <field name="name">freight.route.form</field>
        <field name="model">freight.route</field>
        <field name="arch" type="xml">
            <form string="Freight Route">
                <header>
                    <button name="action_set_planned" string="Planned" type="object"
                        attrs="{'invisible': [('freight_status', '!=', 'cancelled')]}"
                        />
                    <button name="action_set_in_transit" string="In Transit" type="object"
                        attrs="{'invisible': [('freight_status', '!=', 'planned')]}"
                        />
                    <button name="action_set_done" string="Done" type="object"
                        attrs="{'invisible': [('freight_status', '!=', 'in_transit')]}"
                        />
                    <button name="action_set_cancelled" string="Canceled" type="object"
                        attrs="{'invisible': [('freight_status', '=', 'cancelled')]}"
                        />
                    <field name="freight_status" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="last_tracking_status" widget="freight_state_selection" class=""/>
                    <group string="General" name="general">
                        <group>
                            <field name="name" />
                            <field name="route_type" />
                            <field name="origin_id" required="1" />
                        </group>
                        <group>
                            <field name="route_id" />
                            <field name="service_type" />
                            <field name="destination_id" required="1" />
                            <field name="cargo_mode" widget="radio" invisible="1"/>
                        </group>
                    </group>
                    <group string="Transport" name="transport">
                        <group>
                            <field name="transport_mode" required="1" />
                            <field name="ocean_shipping_method_id" string="Loading Method" attrs="{'invisible': [('transport_mode', '!=', 'sea')]}" />
                            <field name="air_shipping_method_id" string="Loading Method" attrs="{'invisible': [('transport_mode', '!=', 'air')]}" />
                            <field name="land_shipping_method_id" string="Loading Method" attrs="{'invisible': [('transport_mode', '!=', 'land')]}" />
                        </group>
                        <group>
                            <field name="vessel_name" attrs="{
                                'invisible': ['|', ('transport_mode', '!=', 'sea'), ('booking_ids', '=', [])]
                            }" />
                            <field name="vessel_voyage_number" attrs="{
                                'invisible': ['|', ('transport_mode', '!=', 'sea'), ('booking_ids', '=', [])]
                            }" />
                            <field name="air_name" attrs="{
                                'invisible': ['|', ('transport_mode', '!=', 'air'), ('booking_ids', '=', [])]
                            }" />
                            <field name="air_voyage_number" attrs="{
                                'invisible': ['|', ('transport_mode', '!=', 'air'), ('booking_ids', '=', [])]
                            }" />

                            <field name="truck_name" attrs="{
                                'invisible': ['|', ('transport_mode', '!=', 'land'), ('booking_ids', '=', [])]
                            }" />
                            <field name="driver_id" attrs="{
                                'invisible': ['|', ('transport_mode', '!=', 'land'), ('booking_ids', '=', [])]
                            }" />
                        </group>
                    </group>
                    <group string="Schedule" name="schedule">
                        <group>
                            <label for="eta" string="Estimated Time"/>
                            <div name="dates" class="o_row">
                                <field name="etd" widget="daterange" options="{&quot;related_end_date&quot;: &quot;eta&quot;}"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" attrs="{'invisible': [('etd', '=', False), ('eta', '=', False)]}"/>
                                <field name="eta" widget="daterange" options="{&quot;related_start_date&quot;: &quot;etd&quot;}"/>
                            </div>
                            <field name="atd" attrs="{'invisible': [('freight_status', 'not in', ['in_transit', 'done'])]}" />
                        </group>
                        <group>
                            <field name="ata" attrs="{'invisible': [('freight_status', '!=', 'done')]}" />
                            <field name="cutoff" />
                        </group>
                    </group>
                    <notebook>
                        <page name="additional_info" string="Additional Info">
                            <group>
                                <group>
                                    <field name="carrier_id" widget="many2one_avatar" required="1" />
                                    <field name="agent_id" widget="many2one_avatar" />
                                    <field name="notify_party_id" widget="many2one_avatar" />
                                </group>
                                <group>
                                    <field name="shipment_id" readonly="1" />
                                    <field name="booking_ids" widget="many2many_tags" />
                                </group>
                            </group>
                        </page>
                        <page string="Packages" name="packages" >
                            <field name="package_ids" domain="[('shipment_id', '=', shipment_id)]">
                                <tree string="Packages">
                                    <field name="name"/>
                                    <field name="package_type_id"/>
                                    <field name="volume"/>
                                    <field name="weight"/>
                                    <field name="container_number" optional="hide"/>
                                    <field name="seal_number" optional="hide"/>
                                    <field name="shipping_mark" optional="hide"/>
                                    <field name="cargo_commodity_ids" invisible="1"/>
                                    <button name="action_view_cargo_commodities" string="View Cargo" type="object" class="btn-secondary"
                                        attrs="{'invisible': [('cargo_commodity_ids', '=', [])]}" icon="fa-eye" />
                                </tree>
                            </field>
                        </page>
                        <page string="Cargo Details" name="cargo_commodities" attrs="{'invisible': [('cargo_mode', '!=', 'structured_entry')]}" >
                            <field name="cargo_commodity_ids" domain="[('shipment_id', '=', shipment_id)]">
                                <tree create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="weight" />
                                    <field name="volume"/>
                                    <field name="shipment_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Cargo Details" name="cargo_note_details"
                            attrs="{'invisible': [('cargo_mode', '=', 'structured_entry')]}" >
                            <field name="cargo_note_details" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="freight_route_view_tree" model="ir.ui.view">
        <field name="name">freight.route.tree</field>
        <field name="model">freight.route</field>
        <field name="arch" type="xml">
            <tree string="Freight Route"
                decoration-success="last_tracking_status == 'on_track'"
                decoration-warning="last_tracking_status == 'at_risk'"
                decoration-danger="last_tracking_status == 'off_track'"
                decoration-info="last_tracking_status == 'on_hold'">
                <field name="sequence" widget="handle" />
                <field name="route_type" optional="show" />
                <field name="name" />
                <field name="freight_status" invisible="1" />
                <field name="origin_id" optional="hide" />
                <field name="destination_id" optional="hide" />
                <field name="shipment_id" optional="hide" />
                <field name="route_id" optional="hide"/>
                <field name="carrier_id" />
                <field name="transport_mode" optional="show" />
                <field name="etd" optional="show" />
                <field name="atd" optional="hide" />
                <field name="eta" optional="show" />
                <field name="ata" optional="hide" />
                <button name="action_set_planned" string="Planned" type="object"
                    attrs="{'invisible': [('freight_status', '!=', 'cancelled')]}"
                    />
                <button name="action_set_in_transit" string="In Transit" type="object"
                    attrs="{'invisible': [('freight_status', '!=', 'planned')]}"
                    />
                <button name="action_set_done" string="Done" type="object"
                    attrs="{'invisible': [('freight_status', '!=', 'in_transit')]}"
                    />
                <button name="action_set_cancelled" string="Canceled" type="object"
                    attrs="{'invisible': [('freight_status', '=', 'cancelled')]}"
                    />
                <button name="action_update_shipment_tracking" type="object"
                    icon="fa-map-marker" string="Update Progress"
                    />
                <field name="last_tracking_status" widget="freight_state_selection" class="" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="freight_route_view_search" model="ir.ui.view">
        <field name="name">freight.route.search</field>
        <field name="model">freight.route</field>
        <field name="arch" type="xml">
            <search string="Freight Route">
                <field name="name" />
                <field name="shipment_id" />
                <field name="route_id" />
                <field name="carrier_id" />
                <field name="transport_mode" />
                <separator />
                <filter name="ftr_sea_route" string="Sea Route" domain="[('transport_mode', '=', 'sea')]"/>
                <filter name="ftr_air_route" string="Air Route" domain="[('transport_mode', '=', 'air')]"/>
                <filter name="ftr_land_route" string="Land Route" domain="[('transport_mode', '=', 'land')]"/>
                <separator />
                <filter name="ftr_pickup" string="Pickup Route" domain="[('route_type', '=', 'pickup')]"/>
                <filter name="ftr_domestic_carriage" string="Domestic Carriage Route" domain="[('route_type', '=', 'domestic_carriage')]"/>
                <filter name="ftr_pre_carriage" string="Pre-carriage Route" domain="[('route_type', '=', 'pre_carriage')]"/>
                <filter name="ftr_main_carriage" string="Main Carriage Route" domain="[('route_type', '=', 'main_carriage')]"/>
                <filter name="ftr_on_carriage" string="On-carriage Route" domain="[('route_type', '=', 'on_carriage')]"/>
                <filter name="ftr_delivery" string="Delivery Route" domain="[('route_type', '=', 'delivery')]"/>
                <separator />
                <group expand="0" string="Group By">
                    <filter name="grp_shipment" string="Shipment" context="{'group_by': 'shipment_id'}" />
                    <filter name="grp_booking" string="Booking" context="{'group_by': 'booking_ids'}" />
                    <filter name="grp_route" string="Route" context="{'group_by': 'route_id'}" />
                    <filter name="grp_carrier" string="Carrier" context="{'group_by': 'carrier_id'}" />
                    <filter name="grp_route_type" string="Route Type" context="{'group_by': 'route_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="freight_route_action" model="ir.actions.act_window">
        <field name="name">Freight Route</field>
        <field name="res_model">freight.route</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
