<odoo>
    <record id="freight_shipping_method_view_form" model="ir.ui.view">
        <field name="name">freight.shipping.method.form</field>
        <field name="model">freight.shipping.method</field>
        <field name="arch" type="xml">
            <form string="Freight Loading Method">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="is_sea" />
                            <field name="is_land" />
                            <field name="is_air" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="freight_shipping_method_view_tree" model="ir.ui.view">
        <field name="name">freight.shipping.method.tree</field>
        <field name="model">freight.shipping.method</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="is_sea" />
                <field name="is_land" />
                <field name="is_air" />
            </tree>
        </field>
    </record>

    <record id="freight_shipping_method_view_search" model="ir.ui.view">
        <field name="name">freight.shipping.method.search</field>
        <field name="model">freight.shipping.method</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="freight_shipping_method_action" model="ir.actions.act_window">
        <field name="name">Freight Loading Methods</field>
        <field name="res_model">freight.shipping.method</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="freight_shipping_method_menu"
        name="Loading Methods"
        parent="freight_menu_config_other"
        action="freight_shipping_method_action"
        sequence="10"
        groups="viin_freight_management.group_freight_manager"
    />
</odoo>
