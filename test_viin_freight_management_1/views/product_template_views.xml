<odoo>
    <record id="freight_product_template_tree_view" model="ir.ui.view">
        <field name="name">freight.product.template.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="after">
                <field name="port_id" optional="hide" />
                <field name="route_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="freight_product_template_only_form_view" model="ir.ui.view">
        <field name="name">freight.product.template.only.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="support_freight_name" attrs="{'invisible': [('detailed_type', '!=', 'freight')]}"/>
                <field name="route_id" attrs="{'invisible': [('detailed_type', '!=', 'freight')]}"/>
                <field name="transport_mode" attrs="{
                    'invisible': [('detailed_type', '!=', 'freight')], 'required': [('detailed_type', '=', 'freight')]}"/>
                <field name="ocean_shipping_method_id" string="Loading Method" attrs="{'invisible': [('transport_mode', '!=', 'sea')]}"/>
                <field name="air_shipping_method_id" string="Loading Method" attrs="{'invisible': [('transport_mode', '!=', 'air')]}"/>
                <field name="land_shipping_method_id" string="Loading Method" attrs="{'invisible': [('transport_mode', '!=', 'land')]}"/>
                <field name="port_id" attrs="{'invisible': [('detailed_type', '!=', 'local_charge')]}"
                    domain="[('is_port', '=', True)]" context="{'default_is_port': True}"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_freight_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="port_id" />
            </xpath>
            <xpath expr="//filter[@name='categ_id']" position="after">
                <filter string="Transport Mode" name="grp_transport_mode" context="{'group_by':'transport_mode'}"/>
                <filter string="Route" name="grp_route" context="{'group_by':'route_id'}"/>
                <filter string="Port" name="grp_port" context="{'group_by':'port_id'}"/>
            </xpath>
            <xpath expr="//filter[@name='services']" position="after">
                <separator/>
                <filter string="Freight" name="ftr_freight_service" domain="[('detailed_type', '=', 'freight')]"/>
                <filter string="Local Charges" name="ftr_local_charge" domain="[('detailed_type', '=', 'local_charge')]"/>
            </xpath>
        </field>
    </record>

    <!-- Actions -->
    <record id="freight_service_action" model="ir.actions.act_window">
        <field name="name">Freight</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('detailed_type', '=', 'freight')]</field>
        <field name="context">{
            'default_detailed_type': 'freight',
            'default_support_freight_name': 'auto',
            'search_default_grp_transport_mode': True
        }</field>
    </record>

    <!-- Local Charge -->
    <record id="local_charge_service_action" model="ir.actions.act_window">
        <field name="name">Local Charges</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('detailed_type', '=', 'local_charge')]</field>
        <field name="context">{'default_detailed_type': 'local_charge'}</field>
    </record>

    <!-- Service Fees -->
    <record id="service_product_action" model="ir.actions.act_window">
        <field name="name">Service Charges</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('detailed_type', '=', 'service')]</field>
        <field name="context">{'default_detailed_type': 'service'}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="freight_operation_menu_freight_charge"
        name="Freights"
        parent="freight_menu_service_charges"
        action="freight_service_action"
        sequence="20"
        groups="viin_freight_management.group_freight_user"/>

    <menuitem id="freight_operation_menu_local_charge"
        name="Local Charges"
        parent="freight_menu_service_charges"
        action="local_charge_service_action"
        sequence="30"
        groups="viin_freight_management.group_freight_user"/>

    <menuitem id="freight_operation_menu_service_charge"
        name="Service Charges"
        parent="freight_menu_service_charges"
        action="service_product_action"
        sequence="40"
        groups="viin_freight_management.group_freight_user"/>

</odoo>
