<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                <button name="action_view_bookings" string="Bookings" type="object"
                    groups="viin_freight_management.group_freight_user"
                    attrs="{'invisible': [('booking_count', '=', 0)]}"
                    class="oe_stat_button" icon="fa-calendar">
                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                </button>
                <field name="shipment_count" invisible="1"/>
                <button name="action_view_shipments" string="Shipment" type="object"
                    groups="viin_freight_management.group_freight_user"
                    attrs="{'invisible': [('shipment_count', '=', 0)]}"
                    class="oe_stat_button" icon="fa-truck">
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="incoterm" options="{'no_open': True, 'no_create': True}" groups="sale_stock.group_display_incoterm" />
            </xpath>
            <xpath expr="//field[@name='analytic_account_id']" position="after">
                <div class="o_row" colspan="2" attrs="{'invisible': [('visible_shipment', '=', False)]}">
                    <field name="visible_shipment" invisible="1"/>
                    <label for="shipment_id" string="Shipment"/>
                    <field name="shipment_id" options="{'no_create': True}" attrs="{'readonly': [('state', 'not in', ['draft', 'sent'])]}"/>
                    <button name="mapping_to_current_shipment" type="object"
                        string="Sync Reference Datas"
                        help="This helps you link sale order and sale order line with shipment when data changes"
                        class="btn-link mb-1 px-0" icon="fa-refresh"
                        confirm="You're going to sync sale order and sale order line with shipment data. Are you sure to proceed?"
                        />
                </div>
                <div class="alert alert-warning" role="alert" colspan="2" attrs="{'invisible': [('mismatched_fields_warning', '=', False)]}">
                    <span class="fa fa-warning" title="Mismatched Shipment Info" />
                    <field name="mismatched_fields_warning" nolabel="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
