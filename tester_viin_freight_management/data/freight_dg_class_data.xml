<odoo noupdate="1">
    <record id="dg_class_1" model="freight.dg.class">
        <field name="code">1</field>
        <field name="name">Explosives</field>
        <field name="description">Materials that may explode</field>
        <field name="special_handling">Store away from heat, impact and static electricity</field>
    </record>

    <record id="dg_class_2" model="freight.dg.class">
        <field name="code">2</field>
        <field name="name">Gases</field>
        <field name="description">Compressed, liquefied, or dissolved gases</field>
        <field name="special_handling">Ventilation required, avoid pressure build-up</field>
    </record>

    <record id="dg_class_3" model="freight.dg.class">
        <field name="code">3</field>
        <field name="name">Flammable Liquids</field>
        <field name="description">Liquids that easily catch fire</field>
        <field name="special_handling">Store in cool, ventilated area, away from flames</field>
    </record>

    <record id="dg_class_4" model="freight.dg.class">
        <field name="code">4</field>
        <field name="name">Flammable Solids</field>
        <field name="description">Solid materials that can ignite easily</field>
        <field name="special_handling">Keep dry, avoid sparks and friction</field>
    </record>

    <record id="dg_class_5" model="freight.dg.class">
        <field name="code">5</field>
        <field name="name">Oxidizing Substances</field>
        <field name="description">Materials that contribute to combustion</field>
        <field name="special_handling">Store separately from flammables</field>
    </record>

    <record id="dg_class_6" model="freight.dg.class">
        <field name="code">6</field>
        <field name="name">Toxic and Infectious Substances</field>
        <field name="description">Poisonous or biohazardous materials</field>
        <field name="special_handling">Use protective equipment, avoid skin contact</field>
    </record>

    <record id="dg_class_7" model="freight.dg.class">
        <field name="code">7</field>
        <field name="name">Radioactive Materials</field>
        <field name="description">Materials that emit radiation</field>
        <field name="special_handling">Shielding required, minimize exposure</field>
    </record>

    <record id="dg_class_8" model="freight.dg.class">
        <field name="code">8</field>
        <field name="name">Corrosive Substances</field>
        <field name="description">Materials that cause severe damage to tissue</field>
        <field name="special_handling">Use resistant containers, avoid contact</field>
    </record>

    <record id="dg_class_9" model="freight.dg.class">
        <field name="code">9</field>
        <field name="name">Miscellaneous Dangerous Goods</field>
        <field name="description">Other hazardous materials (e.g., lithium batteries)</field>
        <field name="special_handling">Follow individual handling instructions</field>
    </record>
</odoo>
