        <field name="origin_id" ref="VN_HAN" />
        <field name="destination_id" ref="VNDVU" />
        <field name="transport_mode">land</field>
        <field name="land_shipping_method_id" ref="viin_freight_management.freight_shipping_method_fcl" />
        <field name="cutoff" eval="(DateTime.now() + timedelta(days=1))" />
        <field name="etd" eval="(DateTime.now() + timedelta(days=2))" />
        <field name="eta" eval="(DateTime.now() + timedelta(days=2))" />
        <field name="carrier_id" ref="viin_freight_management.res_partner_tts_logistics_demo" />
        <field name="agent_id" ref="base.res_partner_10" />
    </record>

