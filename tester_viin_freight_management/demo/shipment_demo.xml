<odoo>

    <!-- Sea FCL Single Route -->
    <record id="shipment_sea_fcl_single_route_demo" model="freight.shipment">
        <field name="service_type">port_to_port</field>
        <field name="transport_mode">sea</field>
        <field name="direction">export</field>
        <field name="responsible_id" ref="base.user_admin"/>
        <field name="shipper_id" ref="base.res_partner_2" />
        <field name="consignee_id" ref="base.res_partner_12" />
        <field name="customer_id" ref="base.res_partner_2" />
        <field name="notify_party_id" ref="base.res_partner_12" />
        <field name="route_id" ref="route_dinhvu_usa" />
        <field name="origin_id" ref="VNDVU" />
        <field name="port_of_loading_id" ref="VNDVU" />
        <field name="port_of_discharge_id" ref="USLAX" />
        <field name="destination_id" ref="USLAX" />
        <field name="carrier_id" ref="viin_freight_management.res_partner_carrier_maersk" />
        <field name="agent_id" ref="base.res_partner_10" />
        <field name="ocean_shipping_method_id" ref="viin_freight_management.freight_shipping_method_fcl" />
        <field name="etd" eval="(DateTime.now() - timedelta(days=40))" />
        <field name="eta" eval="(DateTime.now() - timedelta(days=10))" />
        <field name="current_stage_id" ref="shipment_stage_domestic_delivery" />
        <field name="stage_ids" eval="[(6, 0, [
            ref('shipment_stage_planning_demo'),
            ref('shipment_stage_customs_clearance'),
            ref('shipment_stage_origin_port_handling'),
            ref('shipment_stage_international_transport'),
            ref('shipment_stage_destination_port_handling'),
            ref('shipment_stage_domestic_delivery'),
            ref('shipment_stage_completed'),
        ])]" />
    </record>

    <!-- Sea FCL Multiple Route -->
    <record id="shipment_sea_fcl_multiple_route_demo" model="freight.shipment">
        <field name="service_type">door_to_port</field>
        <field name="direction">export</field>
        <field name="responsible_id" ref="base.user_admin"/>
