#: code:addons/viin_freight_management/models/freight_package.py:0
#, python-format
msgid ""
"You cannot change a booked package %s. If you want to change it, please set "
"status of all booking for this package to Draft before changing."
msgstr ""
"Bạn không thể thay đổi gói hàng %s đã được booking. Nếu bạn muốn thay đổi "
"nó, vui lòng đặt trạng thái của tất cả các booking cho gói hàng này thành Dự"
" thảo trước khi thay đổi."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/cargo_commodity.py:0
#, python-format
msgid ""
"You cannot delete a booked cargo commodity %s. If you want to delete it, "
"please set status of all booking for this cargo commodity to Draft before "
"deleting."
msgstr ""
"Bạn không thể xóa hàng hóa %s đã được booking. Nếu bạn muốn xóa nó, vui lòng"
" đặt trạng thái của tất cả các booking cho hàng hóa này thành Dự thảo trước "
"khi xóa."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/freight_package.py:0
#, python-format
msgid ""
"You cannot delete a booked package %s. If you want to delete it, please set "
"status of all booking for this package to Draft before deleting."
msgstr ""
"Bạn không thể xóa gói hàng %s đã được booking. Nếu bạn muốn xóa nó, vui lòng"
" đặt trạng thái của tất cả các booking cho gói hàng này thành Dự thảo trước "
"khi xóa."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/freight_route.py:0
#, python-format
msgid ""
"You cannot delete a route %s that has a booking with status other than "
"draft.If you want to delete it, please set status of booking %s for this "
"route to Draft before deleting."
msgstr ""
"Bạn không thể xóa tuyến đường %s có booking với trạng thái khác Dự thảo. Nếu"
" bạn muốn xóa nó, vui lòng đặt trạng thái của booking %s cho tuyến đường này"
" thành Dự thảo trước khi xóa."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/freight_booking.py:0
#, python-format
msgid "You cannot delete booking %s that is not in draft state."
msgstr "Bạn không thể xóa booking %s nếu không ở trạng thái dự thảo."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/freight_shipment.py:0
#, python-format
msgid ""
"You cannot delete shipment %s that has bookings. please delete all bookings "
"related to this shipment first."
msgstr ""
"Bạn không thể xóa lô hàng %s khi có booking. Vui lòng xóa tất cả các booking"
" liên quan đến lô hàng này trước."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/sale_order.py:0
#, python-format
msgid ""
"You may not be able to delete the sale order '%s' while it is still referred by the booking `%s`.\n"
"Please remove all the reference bookings first."
msgstr ""
"Bạn không thể xóa đơn bán '%s' khi nó vẫn đang được tham chiếu bởi booking `%s`.\n"
"Vui lòng xóa tất cả các booking tham chiếu trước."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/sale_order.py:0
#, python-format
msgid ""
"You may not be able to delete the sale order '%s' while it is still referred by the route `%s`.\n"
"Please remove all the reference routes first."
msgstr ""
"Bạn không thể xóa đơn bán '%s' khi nó vẫn đang được tham chiếu bởi tuyến đường `%s`.\n"
"Vui lòng xóa tất cả các tuyến đường tham chiếu trước."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/sale_order.py:0
#, python-format
msgid ""
"You may not be able to delete the sale order '%s' while it is still referred by the shipment `%s`.\n"
"Please remove all the reference shipments first."
msgstr ""
"Bạn không thể xóa đơn bán '%s' khi nó vẫn đang được tham chiếu bởi lô hàng `%s`.\n"
"Vui lòng xóa tất cả các lô hàng tham chiếu trước."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/sale_order_line.py:0
#, python-format
msgid ""
"You may not be able to remove the order line `%s` of the order `%s` while it is still referred by the booking `%s`.\n"
"Please remove all the referenced booking first."
msgstr ""
"Bạn không thể xóa dòng đơn bán `%s` của đơn hàng `%s` khi nó vẫn đang được tham chiếu bởi booking `%s`.\n"
"Vui lòng xóa tất cả các booking tham chiếu trước."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/sale_order_line.py:0
#, python-format
msgid ""
"You may not be able to remove the order line `%s` of the order `%s` while it is still referred by the route `%s`.\n"
"Please remove all the referenced route first."
msgstr ""
"Bạn không thể xóa dòng đơn bán `%s` của đơn hàng `%s` khi nó vẫn đang được tham chiếu bởi tuyến đường `%s`.\n"
"Vui lòng xóa tất cả các tuyến đường tham chiếu trước."

#. module: viin_freight_management
#. odoo-python
#: code:addons/viin_freight_management/models/sale_order_line.py:0
#, python-format
msgid ""
"You may not be able to remove the order line `%s` of the order `%s` while it is still referred by the shipment `%s`.\n"
"Please remove all the referenced shipment first."
msgstr ""
"Bạn không thể xóa dòng đơn bán `%s` của đơn hàng `%s` khi nó vẫn đang được tham chiếu bởi lô hàng `%s`.\n"
"Vui lòng xóa tất cả các lô hàng tham chiếu trước."

