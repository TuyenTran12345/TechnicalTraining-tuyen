<odoo>
    <record id="freight_shipment_progress_report_view_tree" model="ir.ui.view">
        <field name="name">freight.shipment.progress.report.tree</field>
        <field name="model">shipment.progress.report</field>
        <field name="arch" type="xml">
            <tree string="Shipment Overview">
                <field name="route_id"/>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="carrier_id"/>
                <field name="agent_id"/>
                <field name="shipping_method_id"/>
                <field name="transport_mode"/>
                <field name="status"/>
                <field name="delivery_status"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <record id="freight_shipment_progress_report_view_pivot" model="ir.ui.view">
        <field name="name">freight.shipment.progress.report.pivot</field>
        <field name="model">shipment.progress.report</field>
        <field name="arch" type="xml">
            <pivot string="Shipment Overview">
                <field name="delivery_status" type="col" string="Delivery Status"/>
                <field name="shipment_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="freight_shipment_progress_report_view_graph" model="ir.ui.view">
        <field name="name">freight.shipment.progress.report.graph.view</field>
        <field name="model">shipment.progress.report</field>
        <field name="arch" type="xml">
            <graph string="Shipment Overview" type="bar">
                <field name="status" type="row"/>
                <field name="shipment_id" type="col"/>
            </graph>
        </field>
    </record>

    <record id="freight_shipment_progress_report_view_search" model="ir.ui.view">
        <field name="name">freight.shipment.progress.report.search</field>
        <field name="model">shipment.progress.report</field>
        <field name="arch" type="xml">
            <search string="Search Shipment Overview">
                <field name="shipment_id"/>
                <field name="route_id"/>
                <field name="customer_id"/>
                <field name="carrier_id"/>
                <field name="agent_id"/>
                <field name="shipping_method_id"/>
                <field name="status"/>
                <field name="date"/>
                <filter string="Early" name="ftr_early" domain="[('delivery_status','=','early')]"/>
                <filter string="Late" name="ftr_delayed" domain="[('delivery_status','=','late')]"/>
                <filter string="On Time" name="ftr_on_time" domain="[('delivery_status','=','on_time')]"/>
                <filter string="In Transit" name="ftr_in_transit" domain="[('delivery_status','=','in_transit')]"/>
                <separator/>
                <filter string="Last 7 Days" name="ftr_last_7" domain="[('date','&gt;=', (context_today() - relativedelta(days=7)).strftime('%%Y-%%m-%%d')), ('date','&lt;=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Month" name="ftr_month" domain="[('date','&gt;=',(context_today()-relativedelta(day=1)).strftime('%%Y-%%m-%%d')), ('date','&lt;=',context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Year" name="ftr_year" domain="[('date','&gt;=',context_today().strftime('%%Y-01-01')), ('date','&lt;=',context_today().strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Shipment" name="grp_shipment" context="{'group_by':'shipment_id'}"/>
                    <filter string="Route Leg" name="grp_route_leg" context="{'group_by':'freight_route_id'}"/>
                    <filter string="Route" name="grp_route" context="{'group_by':'route_id'}"/>
                    <separator/>
                    <filter string="Carrier" name="grp_carrier" context="{'group_by':'carrier_id'}"/>
                    <filter string="Agent" name="grp_agent" context="{'group_by':'agent_id'}"/>
                    <filter string="Customer" name="grp_customer" context="{'group_by':'customer_id'}"/>
                    <separator/>
                    <filter string="Responsible" name="grp_responsible" context="{'group_by':'responsible_id'}"/>
                    <filter string="Sales Person" name="grp_sale_person" context="{'group_by':'sale_person_id'}"/>
                    <separator/>
                    <filter string="Method" name="grp_shipping_method" context="{'group_by':'shipping_method_id'}"/>
                    <filter string="Status" name="grp_status" context="{'group_by':'status'}"/>
                    <filter string="Delivery Status" name="grp_delivery_status" context="{'group_by':'delivery_status'}"/>
                    <separator/>
                    <filter string="ETD" name="grp_etd" context="{'group_by':'etd'}"/>
                    <filter string="ETA" name="grp_eta" context="{'group_by':'eta'}"/>
                    <filter string="ATD" name="grp_atd" context="{'group_by':'atd'}"/>
                    <filter string="ATA" name="grp_ata" context="{'group_by':'ata'}"/>
                    <filter string="Created Date" name="grp_date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_freight_shipment_progress_report" model="ir.actions.act_window">
        <field name="name">Shipment Overview</field>
        <field name="res_model">shipment.progress.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="freight_shipment_progress_report_view_search"/>
        <field name="context"></field>
        <field name="help">This report provides detailed analysis of each route leg in your shipments.</field>
    </record>

    <menuitem
        id="menu_freight_route_report"
        name="Shipment Overview"
        parent="viin_freight_management.freight_report_menu_root"
        action="action_freight_shipment_progress_report"
        sequence="10"/>
</odoo>
