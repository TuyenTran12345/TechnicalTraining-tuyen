<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="viin_freight_management.ShipmentProfitability" owl="1">
        <!-- Profitability Details -->
        <!-- Revenues -->
        <div class="d-flex justify-content-between h4 fw-bold">
            <span>Revenues</span>
        </div>
        <div class="o_profitability_grid">
            <!-- Header -->
            <div class="row text-muted small border-bottom mx-0 px-3 pb-1 mb-1">
                <div class="col-6">Description</div>
                <div class="col-2 text-end">Invoiced</div>
                <div class="col-2 text-end">To Invoice</div>
                <div class="col-2 text-end">Expected</div>
            </div>
            <!-- Body -->
            <t t-foreach="props.data.revenues.data" t-as="line" t-key="line.id">
                <div class="row mx-0 px-3 py-1">
                    <div class="col-6 text-truncate" t-att-title="line.name">
                        <t t-esc="line.name"/>
                    </div>
                    <div class="col-2 text-end"><t t-esc="format(line.billed_amount)"/></div>
                    <div class="col-2 text-end"><t t-esc="format(line.to_bill_amount)"/></div>
                    <div class="col-2 text-end"><t t-esc="format(line.amount)"/></div>
                </div>
            </t>
            <!-- Footer -->
            <div class="row border-top mx-0 px-3 pt-1 mt-1">
                <div class="col-6"><strong>Total</strong></div>
                <div class="col-2 text-end fw-bold"><t t-esc="format(totalRevenue.billed)"/></div>
                <div class="col-2 text-end fw-bold"><t t-esc="format(totalRevenue.to_bill)"/></div>
                <div class="col-2 text-end fw-bold" t-att-class="totalRevenue.expected ? 'text-success' : ''">
                    <t t-esc="format(totalRevenue.expected)"/>
                </div>
            </div>
        </div>

        <!-- Costs -->
        <div class="d-flex justify-content-between h4 fw-bold mt-3">
            <span>Costs</span>
        </div>
        <div class="o_profitability_grid">
            <!-- Header -->
            <div class="row text-muted small border-bottom mx-0 px-3 pb-1 mb-1">
                <div class="col-6">Description</div>
                <div class="col-2 text-end">Billed</div>
                <div class="col-2 text-end">To Bill</div>
                <div class="col-2 text-end">Expected</div>
            </div>
            <!-- Body -->
            <t t-foreach="props.data.costs.data" t-as="line" t-key="line.id">
                <div class="row mx-0 px-3 py-1">
                    <div class="col-6 text-truncate" t-att-title="line.name">
                        <t t-esc="line.name"/>
                    </div>
                    <div class="col-2 text-end"><t t-esc="format(line.billed_amount)"/></div>
                    <div class="col-2 text-end"><t t-esc="format(line.to_bill_amount)"/></div>
                    <div class="col-2 text-end"><t t-esc="format(line.amount)"/></div>
                </div>
            </t>
            <!-- Footer -->
            <div class="row border-top mx-0 px-3 pt-1 mt-1">
                <div class="col-6"><strong>Total</strong></div>
                <div class="col-2 text-end fw-bold"><t t-esc="format(totalCosts.billed)"/></div>
                <div class="col-2 text-end fw-bold"><t t-esc="format(totalCosts.to_bill)"/></div>
                <div class="col-2 text-end fw-bold" t-att-class="totalCosts.expected ? 'text-danger' : ''">
                    <t t-esc="format(totalCosts.expected)"/>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="d-flex justify-content-between h4 fw-bold">
                    <span>Profit</span>
                    <strong t-att-class="profit > 0 ? 'text-success' : (profit &lt; 0 ? 'text-danger' : '')"><t t-esc="format(profit)"/></strong>
                </div>
            </div>
        </div>
    </t>

</templates>
