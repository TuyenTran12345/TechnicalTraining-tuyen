<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="viin_freight_management.ShipmentRightSidePanelSection" owl="1">
        <div t-if="props.show" t-att-class="'o_rightpanel_section o_sp_rightpanel_section_' + props.name">
            <div t-if="props.slots.title" class="o_rightpanel_section_header">
                <h6 class="o_rightpanel_section_title">
                    <t t-slot="title"/>
                </h6>
            </div>
            <div class="o_rightpanel_section_content">
                <t t-slot="default"/>
            </div>
        </div>
    </t>

</templates>
