<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="freight_booking_tree_view" model="ir.ui.view">
        <field name="name">freight.booking.tree</field>
        <field name="model">freight.booking</field>
        <field name="arch" type="xml">
            <tree create="0" string="Bookings" decoration-info="state == 'draft'" 
                                    decoration-success="state == 'confirmed'" 
                                    decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="booking_date"/>
                <field name="responsible_id" widget="many2one_avatar_user" optional="show"/>
                <field name="carrier_id" widget="many2one_avatar" optional="show"/>
                <field name="shipper_id" widget="many2one_avatar" optional="show"/>
                <field name="consignee_id" widget="many2one_avatar" optional="show"/>
                <field name="transport_mode"/>
                <field name="etd" optional="hide"/>
                <field name="eta" optional="hide"/>
                <field name="total_weight" optional="hide"/>
                <field name="total_volume" optional="hide"/>
                <field name="state" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="freight_booking_view_form" model="ir.ui.view">
        <field name="name">freight.booking.form</field>
        <field name="model">freight.booking</field>
        <field name="arch" type="xml">
            <form create="0" string="Booking">
                <header>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'" />
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_done" string="Done" type="object" class="oe_highlight" invisible="state != 'confirmed'" />
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group name="general_info" string="General">
                        <group>
                            <field name="booking_ref" placeholder="External booking reference..."
                                readonly="state != 'draft'"
                            />
                            <field name="master_bill_number" />
                            <field name="booking_date" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="carrier_id" widget="many2one_avatar" readonly="state != 'draft'" />
                            <field name="agent_id" widget="many2one_avatar" readonly="state != 'draft'" />
                            <field name="notify_party_id" widget="many2one_avatar" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group name="transport_mode" string="Transport Mode"
                            invisible="multiple_leg_route">
                        <group>
                            <field name="transport_mode" widget="radio" readonly="state != 'draft'" />
                        </group>
                        <group invisible="multiple_leg_route">
                            <!-- Sea -->
                            <field name="ocean_shipping_method_id" options="{'no_create': True}"
                                string="Loading Method"
                                invisible="transport_mode != 'sea'"
                                readonly="state != 'draft'"
                            />
                            <field name="vessel_name" placeholder="Vessel name..."
                                invisible="transport_mode != 'sea'"
                                readonly="state != 'draft'"
                            />
                            <field name="vessel_voyage_number" placeholder="Voyage number..."
                                invisible="transport_mode != 'sea'"
                                readonly="state != 'draft'"
                            />

                            <!-- Air -->
                            <field name="air_shipping_method_id" options="{'no_create': True}"
                                string="Loading Method"
                                invisible="transport_mode != 'air'"
                                readonly="state != 'draft'"
                            />
                            <field name="air_name" placeholder="Aircraft/Flight..."
                                invisible="transport_mode != 'air'"
                                readonly="state != 'draft'"
                            />
                            <field name="air_voyage_number" placeholder="Flight number..."
                                invisible="transport_mode != 'air'"
                                readonly="state != 'draft'"
                            />

                            <!-- Land -->
                            <field name="land_shipping_method_id" options="{'no_create': True}"
                                string="Loading Method"
                                invisible="transport_mode != 'land'"
                                readonly="state != 'draft'"
                            />
                            <field name="truck_name" placeholder="Truck/Vehicle..."
                                invisible="transport_mode != 'land'"
                                readonly="state not in ('confirmed', 'draft')"
                            />
                            <field name="driver_id" options="{'no_create': True}"
                                invisible="transport_mode != 'land'"
                                readonly="state not in ('confirmed', 'draft')"
                            />
                        </group>
                    </group>

                    <group name="schedule" string="Schedule">
                        <group>
                            <field name="etd" widget="datetime" readonly="multiple_leg_route or state != 'draft'" />
                            <field name="cutoff" widget="datetime" readonly="multiple_leg_route or state != 'draft'" />
                        </group>
                        <group>
                            <field name="eta" widget="datetime" readonly="multiple_leg_route or state != 'draft'" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Route" name="route_information">
                            <group invisible="multiple_leg_route" name="configuration" string="Configuration">
                                <group>
                                    <field name="service_type" readonly="state != 'draft'" />
                                </group>
                                <group>
                                    <field name="multiple_leg_route" readonly="1" invisible="1"/>
                                    <field name="route_id" readonly="state != 'draft'" />
                                </group>
                            </group>
                            <group string="Locations" name="locations" invisible="multiple_leg_route">
                                <group>
                                    <field name="origin_id" readonly="state != 'draft'" />
                                    <field name="port_of_loading_id" readonly="state != 'draft'" />
                                </group>
                                <group>
                                    <field name="destination_id" readonly="state != 'draft'" />
                                    <field name="port_of_discharge_id" readonly="state != 'draft'" />
                                </group>
                            </group>

                            <!-- Multiple Leg Routes -->
                            <separator string="Route Legs" invisible="not multiple_leg_route"/>
                            <field name="freight_route_ids" invisible="not multiple_leg_route">
                                <tree string="Freight Route" create="0" edit="0" delete="0">
                                    <field name="route_type" optional="show" />
                                    <field name="name" />
                                    <field name="origin_id" optional="hide" />
                                    <field name="destination_id" optional="hide" />
                                    <field name="freight_status" column_invisible="1" />
                                    <field name="route_id" optional="hide"/>
                                    <field name="carrier_id" />
                                    <field name="transport_mode" optional="show" />
                                    <field name="etd" optional="show" />
                                    <field name="atd" optional="hide" />
                                    <field name="eta" optional="show" />
                                    <field name="ata" optional="hide" />
                                </tree>
                            </field>
                        </page>
                        <!-- Tab 2: Cargo -->
                        <page string="Cargo" name="cargo">
                            <group name="cargo_summary_group" string="Summary">
                                <group>
                                    <field name="total_packages" readonly="1"/>
                                    <field name="total_cargo_commodities" readonly="1"/>
                                </group>
                                <group>
                                    <label for="total_weight" string="Total Weight"/>
                                    <div class="o_row">
                                        <field name="total_weight"/>
                                        <field name="weight_uom_name"/>
                                    </div>
                                    <label for="total_volume" string="Total Volume"/>
                                    <div class="o_row">
                                        <field name="total_volume"/>
                                        <field name="volume_uom_name"/>
                                    </div>
                                </group>
                            </group>

                            <separator string="Packages"/>
                            <field name="package_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="package_type_id" optional="show"/>
                                    <field name="weight"/>
                                    <field name="volume"/>
                                    <field name="container_number" optional="hide"/>
                                    <field name="seal_number" optional="hide"/>
                                    <field name="shipping_mark" optional="hide"/>
                                    <field name="cargo_commodity_ids" column_invisible="1"/>
                                    <button name="action_view_cargo_commodities" string="View Cargo" type="object" class="btn-secondary"
                                        invisible="not cargo_commodity_ids" icon="fa-eye" />
                                </tree>
                            </field>

                            <separator string="Cargo Details" invisible="package_ids"/>
                            <field name="cargo_commodity_ids" readonly="1" invisible="package_ids or cargo_mode != 'structured_entry'" />
                            <field name="cargo_note_details" invisible="cargo_mode == 'structured_entry' or package_ids" />
                        </page>

                        <!-- Tab 3: Other -->
                        <page string="Other" name="other">
                            <group string="Shipment" name="shipment_info">
                                <group>
                                    <field name="shipment_id" readonly="1"/>
                                    <field name="responsible_id" widget="many2one_avatar_user" readonly="state != 'draft'" />
                                    <field name="stakeholder_user_ids" widget="many2many_tags_avatar" 
                                        readonly="state != 'draft'"
                                        help="Users who will be notified about booking issues"/>
                                </group>
                                <group>
                                    <field name="shipper_id" widget="many2one_avatar" readonly="1"/>
                                    <field name="consignee_id" widget="many2one_avatar" readonly="1"/>
                                </group>
                            </group>
                            <group string="Cargo" name="cargo_info" invisible="1">
                                <field name="cargo_mode" widget="radio" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="freight_booking_search_view" model="ir.ui.view">
        <field name="name">freight.booking.search</field>
        <field name="model">freight.booking</field>
        <field name="arch" type="xml">
            <search string="Search Bookings">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <separator/>
                <filter string="Draft" name="ftr_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="ftr_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="ftr_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Multiple Leg Route" name="ftr_multi_leg" domain="[('multiple_leg_route', '=', True)]"/>
                <filter string="Single Leg Route" name="ftr_single_leg" domain="[('multiple_leg_route', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Transport Mode" name="grp_by_transport_mode" context="{'group_by': 'transport_mode'}"/>
                    <filter string="Status" name="grp_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Responsible" name="grp_by_responsible" context="{'group_by': 'responsible_id'}"/>
                    <separator/>
                    <filter string="Carrier" name="grp_by_carrier" context="{'group_by': 'carrier_id'}"/>
                    <filter string="Shipper" name="grp_by_shipper" context="{'group_by': 'shipper_id'}"/>
                    <filter string="Consignee" name="grp_by_consignee" context="{'group_by': 'consignee_id'}"/>
                    <separator/>
                    <filter string="Origin" name="grp_by_origin" context="{'group_by': 'origin_id'}"/>
                    <filter string="Destination" name="grp_by_destination" context="{'group_by': 'destination_id'}"/>
                    <separator/>
                    <filter string="Booking Date" name="grp_by_booking_date" context="{'group_by': 'booking_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="freight_booking_calendar_view" model="ir.ui.view">
        <field name="name">freight.booking.calendar</field>
        <field name="model">freight.booking</field>
        <field name="arch" type="xml">
            <calendar create="0" string="Bookings" date_start="cutoff" color="state" mode="month">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="transport_mode"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Action -->
    <record id="action_freight_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">freight.booking</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="search_view_id" ref="freight_booking_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Booking!
            </p>
        </field>
    </record>

    <menuitem id="freight_operation_menu_booking" name="Booking"
        parent="freight_operation_menu_root"
        action="action_freight_booking"
        sequence="20" groups="viin_freight_management.group_freight_user"/>
</odoo>
