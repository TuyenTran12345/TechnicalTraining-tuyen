<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="cargo_commodity_tree_view" model="ir.ui.view">
        <field name="name">cargo.commodity.tree.view</field>
        <field name="model">cargo.commodity</field>
        <field name="arch" type="xml">
            <tree string="Cargo Commodities">
                <field name="cargo_template_id" column_invisible="1"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="weight" />
                <field name="volume"/>
                <field name="hs_code_id" optional="hide"/>
                <field name="cargo_type_id" optional="hide"/>
                <field name="shipment_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="cargo_commodity_form_view" model="ir.ui.view">
        <field name="name">cargo.commodity.form.view</field>
        <field name="model">cargo.commodity</field>
        <field name="arch" type="xml">
            <form string="Cargo Commodity">
                <sheet>
                    <group string="Cargo Commodity Information" colspan="2">
                        <group>
                            <field name="name" placeholder="Cargo Commodity Description..."/>
                            <field name="is_individual_package" />
                        </group>
                        <group>
                            <label for="quantity" string="Quantity"/>
                            <div class="o_row">
                                <field name="quantity" />
                                <span>x</span>
                                <field name="package_type_id" invisible="not is_individual_package"/>
                                <field name="uom_id" invisible="is_individual_package"/>
                            </div>
                            <field name="need_marking" invisible="quantity != 1"/>
                            <field name="shipping_mark" invisible="not need_marking"/>
                        </group>
                    </group>

                    <group string="Physical Properties" colspan="2">
                        <group>
                            <label for="weight" string="Weight"/>
                            <div class="o_row">
                                <field name="weight"/>
                                <field name="weight_uom_name"/>
                            </div>
                        </group>
                        <group>
                            <label for="volume" string="Volume"/>
                            <div class="o_row">
                                <field name="volume"/>
                                <field name="volume_uom_name"/>
                            </div>
                        </group>
                    </group>

                    <group string="Cargo Classification" colspan="2">
                        <group>
                            <field name="cargo_type_id"/>
                            <field name="hs_code_id"/>
                            <field name="country_of_origin_id"/>
                            <field name="import_tax_rate"
                                invisible="not hs_code_id or not country_of_origin_id"/>
                        </group>
                        <group>
                            <field name="is_danger"/>
                            <field name="dg_class_id" invisible="not is_danger"/>
                            <field name="un_number_id" options="{'no_create': True}"
                                domain="[('dg_class_id', '=', dg_class_id)]"
                                invisible="not is_danger"/>
                        </group>
                    </group>

                    <group string="Dangerous Goods Details" invisible="not is_danger" colspan="2">
                        <group>
                            <field name="packaging_group" readonly="1"/>
                        </group>
                        <group>
                            <field name="flash_point" readonly="1"/>
                        </group>
                    </group>

                    <group string="References" colspan="2">
                        <group>
                            <field name="shipment_id" readonly="1"/>
                            <field name="cargo_template_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="booking_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Handling Instructions">
                            <field name="handling_instructions"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Search View -->
    <record id="cargo_commodity_search_view" model="ir.ui.view">
        <field name="name">cargo.commodity.search.view</field>
        <field name="model">cargo.commodity</field>
        <field name="arch" type="xml">
            <search string="Search Cargo Commodities">
                <field name="name"/>
                <field name="cargo_type_id"/>
                <field name="hs_code_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Cargo Type" name="grp_cargo_type" context="{'group_by': 'cargo_type_id'}"/>
                    <filter string="HS Code" name="grp_hs_code" context="{'group_by': 'hs_code_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cargo_commodities" model="ir.actions.act_window">
        <field name="name">Cargo Commodities</field>
        <field name="res_model">cargo.commodity</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="cargo_commodity_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Cargo Commodities!
            </p>
        </field>
    </record>

    <record id="cargo_commodity_action_convert_to_template" model="ir.actions.server">
        <field name="name">Convert to Template</field>
        <field name="model_id" ref="model_cargo_commodity"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_cargo_commodity"/>
        <field name="code">action = records.sudo().convert_to_template()</field>
    </record>
</odoo>
