<odoo>
    <record id="action_report_hbl" model="ir.actions.report">
        <field name="name">HBL</field>
        <field name="model">freight.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">viin_freight_management.report_hbl</field>
        <field name="report_file">viin_freight_management.report_hbl</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="attachment">object._get_report_attachment_filename()</field>
        <field name="binding_model_id" ref="model_freight_shipment"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('viin_freight_management.group_freight_user'))]"/>
    </record>

    <record id="action_report_bk_request" model="ir.actions.report">
        <field name="name">Booking Request</field>
        <field name="model">freight.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">viin_freight_management.report_bk_request</field>
        <field name="report_file">viin_freight_management.report_bk_request</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="attachment">object._get_report_attachment_filename()</field>
        <field name="binding_model_id" ref="model_freight_booking"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('viin_freight_management.group_freight_user'))]"/>
    </record>
</odoo>
