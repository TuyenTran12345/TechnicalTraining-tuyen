<odoo>

    <record id="route_form" model="ir.ui.view">
        <field name="name">route.route.form.freight.inherit</field>
        <field name="model">route.route</field>
        <field name="inherit_id" ref="to_geo_routes.route_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="service_type" />
            </xpath>
        </field>
    </record>

    <record id="geo_route_freight_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">route.route</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>No routes found. Create one to start using it in shipments.</p>
        </field>
    </record>

    <menuitem id="freight_menu_route_data" name="Routes"
        parent="freight_location_menu_root"
        action="geo_route_freight_action"
        sequence="20"
        groups="viin_freight_management.group_freight_user"/>
</odoo>
