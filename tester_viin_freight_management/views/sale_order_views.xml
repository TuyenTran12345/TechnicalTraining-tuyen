<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button name="action_view_bookings" string="Bookings" type="object"
                    groups="viin_freight_management.group_freight_user"
                    invisible="booking_count == 0"
                    class="oe_stat_button" icon="fa-calendar">
                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                </button>
                <field name="shipment_count" invisible="1"/>
                <button name="action_view_shipments" string="Shipment" type="object"
                    groups="viin_freight_management.group_freight_user"
                    invisible="shipment_count == 0"
                    class="oe_stat_button" icon="fa-truck">
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="incoterm" options="{'no_open': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='analytic_account_id']" position="after">
                <div class="o_row" colspan="2" invisible="not visible_shipment">
                    <field name="visible_shipment" invisible="1"/>
                    <label for="shipment_id" string="Shipment"/>
                    <field name="shipment_id" options="{'no_create': True}" readonly="state not in ['draft', 'sent']"/>
                    <button name="mapping_to_current_shipment" type="object"
                        string="Sync Reference Datas"
                        help="This helps you link sale order and sale order line with shipment when data changes"
                        class="btn-link mb-1 px-0" icon="fa-refresh"
                        confirm="You're going to sync sale order and sale order line with shipment data. Are you sure to proceed?"
                        />
                </div>
                <div class="alert alert-warning" role="alert" colspan="2" invisible="not mismatched_fields_warning">
                    <span class="fa fa-warning" title="Mismatched Shipment Info" />
                    <field name="mismatched_fields_warning" nolabel="1" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="after">
                <filter string="Export" name="export" domain="[('direction', '=', 'export')]"/>
                <filter string="Import" name="import" domain="[('direction', '=', 'import')]"/>
                <filter string="Domestic" name="domestic" domain="[('direction', '=', 'domestic')]"/>
                <separator/>
                <filter string="FCL" name="fcl" domain="['|','|', ('ocean_shipping_method_id.name', 'ilike', 'FCL'), ('air_shipping_method_id.name', 'ilike', 'FCL'), ('land_shipping_method_id.name', 'ilike', 'FCL')]"/>
                <filter string="LCL" name="lcl" domain="['|','|', ('ocean_shipping_method_id.name', 'ilike', 'LCL'), ('air_shipping_method_id.name', 'ilike', 'LCL'), ('land_shipping_method_id.name', 'ilike', 'LCL')]"/>
                <separator/>
                <group expand="0" string="Direction">
                    <filter string="Direction" name="direction" domain="[]" context="{'group_by': 'direction'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
