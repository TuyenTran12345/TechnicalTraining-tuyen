<odoo>
    <!-- Tree View -->
    <record id="shipment_status_tree_view" model="ir.ui.view">
        <field name="name">freight.shipment.status.tree.view</field>
        <field name="model">freight.shipment.status.template</field>
        <field name="arch" type="xml">
            <tree string="Shipment Status">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="shipment_status_form_view" model="ir.ui.view">
        <field name="name">freight.shipment.status.form.view</field>
        <field name="model">freight.shipment.status.template</field>
        <field name="arch" type="xml">
            <form string="Shipment Status">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="shipment_status_search_view" model="ir.ui.view">
        <field name="name">freight.shipment.status.search.view</field>
        <field name="model">freight.shipment.status.template</field>
        <field name="arch" type="xml">
            <search string="Shipment Status">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active','=', False)]"/>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_shipment_status" model="ir.actions.act_window">
        <field name="name">Shipment Status</field>
        <field name="res_model">freight.shipment.status.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="shipment_status_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your shipment status to track shipment
            </p>
        </field>
    </record>
    
    <!-- Menu Item -->
    <menuitem id="freight_menu_config_shipment_status"
        name="Shipment Status"
        parent="freight_menu_config_other"
        action="action_shipment_status"
        sequence="30"/>
</odoo>
