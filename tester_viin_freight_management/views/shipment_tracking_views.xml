<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shipment_tracking_tree_view" model="ir.ui.view">
        <field name="name">shipment.tracking.tree.view</field>
        <field name="model">freight.shipment.tracking</field>
        <field name="arch" type="xml">
            <tree string="Shipment Tracking">
                <field name="event_time"/>
                <field name="location" optional="show"/>
                <field name="title_template_id" optional="show"/>
                <field name="details" optional="show"/>
                <field name="shipment_id" optional="hide"/>
                <field name="freight_route_id" optional="hide"/>
                <field name="stage_id" optional="hide"/>
                <field name="is_published" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="shipment_tracking_form_view" model="ir.ui.view">
        <field name="name">shipment.tracking.form.view</field>
        <field name="model">freight.shipment.tracking</field>
        <field name="arch" type="xml">
            <form string="Shipment Tracking">
                <header />
                <sheet>
                    <group>
                        <group>
                            <field name="event_time" help="When this tracking event occurred"/>
                            <field name="location" placeholder="e.g. Ho Chi Minh Port"/>
                            <field name="freight_route_id"
                                domain="[('shipment_id', '=', shipment_id)]"
                                invisible="not multiple_leg_route"
                                required="multiple_leg_route and need_update_shipment_plan" />
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="need_update_shipment_plan"/>
                            <field name="should_send_notification" invisible="1"/>
                            <field name="status" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="title_template_id"/>
                                <field name="details"
                                    placeholder="Enter detailed information about this tracking update..."
                                    help="Detailed information about this tracking update"/>
                            </group>
                        </page>
                        <page string="Update Shipment Plan" name="update_shipment_plan"
                            invisible="not need_update_shipment_plan">
                            <group string="Transportation" name="transportation">

                                <group>
                                    <field name="route_id"/>
                                    <field name="transport_mode"/>
                                    <field name="service_type"/>
                                </group>
                                <group>
                                    <field name="ocean_shipping_method_id" string="Loading Method" invisible="transport_mode != 'sea'" />
                                    <field name="vessel_name" invisible="transport_mode != 'sea'" />
                                    <field name="vessel_voyage_number" invisible="transport_mode != 'sea'" />

                                    <field name="air_shipping_method_id" string="Loading Method" invisible="transport_mode != 'air'" />
                                    <field name="air_name" invisible="transport_mode != 'air'" />
                                    <field name="air_voyage_number" invisible="transport_mode != 'air'" />

                                    <field name="land_shipping_method_id" string="Loading Method" invisible="transport_mode != 'land'" />
                                    <field name="driver_id" invisible="transport_mode != 'land'"
                                        widget="res_partner_many2one"
                                        context="{'show_address': 1,}"
                                        options="{'always_reload': True}"/>
                                    <field name="truck_name" invisible="transport_mode != 'land'" />
                                </group>
                            </group>
                            <group string="Location" name="location">
                                <group>
                                    <field name="origin_id"/>
                                    <field name="port_of_loading_id"/>
                                </group>
                                <group>
                                    <field name="port_of_discharge_id"/>
                                    <field name="destination_id"/>
                                </group>
                            </group>
                            <group string="Schedule" name="schedule">
                                <group>
                                    <field name="etd"/>
                                    <field name="atd"/>
                                    <field name="cutoff"/>
                                </group>
                                <group>
                                    <field name="eta"/>
                                    <field name="ata"/>
                                </group>
                            </group>
                            <group string="Participants" name="participants">
                                <group>
                                    <field name="consignee_id"/>
                                    <field name="notify_party_id"/>
                                </group>
                                <group>
                                    <field name="carrier_id"/>
                                    <field name="agent_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <group>
                                    <field name="shipment_id" readonly="1"/>
                                    <field name="multiple_leg_route" invisible="1"/>
                                </group>
                                <group>
                                    <field name="stage_id" />
                                </group>
                            </group>
                            <group string="Notify" name="notify">
                                <label for="notify_to_partner_ids" string="Notify To"/>
                                <div class="o_row">
                                    <field name="notify_to_partner_ids" widget="many2many_tags_email"
                                        context="{'force_email': True, 'show_email': True, 'no_create_edit': True}"
                                        placeholder="Select partners to notify..."
                                        options="{'no_create': True}"
                                        help="Partners who will receive email notifications about this tracking update"/>
                                        <button name="action_send_update_email" icon="fa-envelope" string="Send Email"
                                            invisible="not should_send_notification"
                                            type="object"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" type="object" special="save"/>
                    <button name="action_send_update_email" icon="fa-envelope" string="Send Email"
                        invisible="not should_send_notification"
                        type="object"/>
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Shipment Tracking Kanban View -->
    <record id="view_freight_shipment_tracking_kanban" model="ir.ui.view">
        <field name="name">freight.shipment.tracking.kanban</field>
        <field name="model">freight.shipment.tracking</field>
        <field name="arch" type="xml">
            <kanban class="o_shipment_tracking_kanban" js_class="shipment_tracking_kanban_with_sidebar">
                <field name="title_template_id"/>
                <field name="event_time"/>
                <field name="location"/>
                <field name="status"/>
                <field name="stage_id"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_detail_ungrouped">
                                <div class="row m-0 p-3 align-items-center justify-content-center">
                                    <div class="col-lg-4 col-md-6 col-12 o_kanban_record_title o_text_overflow">
                                        <strong><field name="title_template_id"/></strong>
                                    </div>
                                    <div class="col-lg-3 col-md-6 col-12 text-muted">
                                        <i class="fa fa-map-marker me-1" aria-label="Location"/>
                                        <field name="location"/>
                                    </div>
                                    <div class="col-lg-3 col-md-6 col-12 text-muted">   
                                        <i class="fa fa-clock-o me-1" aria-label="Event Time"/>
                                        <field name="event_time"/>
                                    </div>
                                    <div class="col-lg-1 col-md-3 col-6 text-lg-end">
                                        <field name="status" widget="badge" decoration-success="status == 'on_track'" decoration-warning="status == 'at_risk'" decoration-danger="status == 'off_track'" decoration-info="status == 'on_hold'"/>
                                    </div>
                                    <div class="col-lg-1 col-md-3 col-6 text-lg-end">
                                        <i t-if="record.is_published.raw_value" class="fa fa-globe" title="Published on Portal"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="shipment_tracking_search_view" model="ir.ui.view">
        <field name="name">shipment.tracking.search.view</field>
        <field name="model">freight.shipment.tracking</field>
        <field name="arch" type="xml">
            <search string="Search Shipment Tracking">
                <field name="title_template_id"/>
                <field name="shipment_id"/>
                <field name="stage_id"/>
                <field name="location"/>
                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Unpublished" name="unpublished" domain="[('is_published', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Shipment" name="group_by_shipment" context="{'group_by': 'shipment_id'}"/>
                    <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Event Time" name="group_by_event_time" context="{'group_by': 'event_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_tracking" model="ir.actions.act_window">
        <field name="name">Shipment Tracking</field>
        <field name="res_model">freight.shipment.tracking</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="shipment_tracking_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Shipment Tracking!
            </p>
        </field>
    </record>

    <!-- Kanban View with Sidebar -->
    <record id="view_freight_shipment_tracking_kanban_with_sidebar" model="ir.ui.view">
        <field name="name">freight.shipment.tracking.kanban.sidebar</field>
        <field name="model">freight.shipment.tracking</field>
        <field name="arch" type="xml">
            <kanban js_class="shipment_tracking_kanban_with_sidebar">
                <field name="title_template_id"/>
                <field name="event_time"/>
                <field name="location"/>
                <field name="status"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_detail_ungrouped">
                                <div class="row m-0 p-3">
                                    <div class="col-lg-4 col-md-6 col-12 o_kanban_record_title">
                                        <strong><field name="title_template_id"/></strong>
                                    </div>
                                    <div class="col-lg-3 col-md-6 col-12 text-muted">
                                        <i class="fa fa-map-marker me-1" aria-label="Location"/>
                                        <field name="location"/>
                                    </div>
                                    <div class="col-lg-3 col-md-6 col-12 text-muted">
                                        <i class="fa fa-clock-o me-1" aria-label="Event Time"/>
                                        <field name="event_time"/>
                                    </div>
                                    <div class="col-lg-1 col-md-3 col-6 text-lg-end">
                                        <field name="status" widget="badge" decoration-success="status == 'on_track'" decoration-warning="status == 'at_risk'" decoration-danger="status == 'off_track'" decoration-info="status == 'on_hold'"/>
                                    </div>
                                    <div class="col-lg-1 col-md-3 col-6 text-lg-end">
                                        <i t-if="record.is_published.raw_value" class="fa fa-globe" title="Published on Portal"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for the view with Sidebar -->
    <record id="action_shipment_tracking_with_sidebar" model="ir.actions.act_window">
        <field name="name">Shipment Tracking</field>
        <field name="res_model">freight.shipment.tracking</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_freight_shipment_tracking_kanban_with_sidebar')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('shipment_tracking_tree_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('shipment_tracking_form_view')})]"/>
        <field name="search_view_id" ref="shipment_tracking_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Shipment Tracking!
            </p>
        </field>
    </record>

</odoo>
