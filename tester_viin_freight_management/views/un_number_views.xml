<odoo>
    <record id="un_number_view_form" model="ir.ui.view">
        <field name="name">freight.un.number.form</field>
        <field name="model">freight.un.number</field>
        <field name="arch" type="xml">
            <form string="UN Number">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="proper_shipping_name" />
                            <field name="dg_class_id" />
                        </group>
                        <group>
                            <field name="packaging_group" />
                            <field name="special_provisions" />
                            <field name="flash_point" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="un_number_view_tree" model="ir.ui.view">
        <field name="name">freight.un.number.tree</field>
        <field name="model">freight.un.number</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="proper_shipping_name" />
                <field name="dg_class_id" />
            </tree>
        </field>
    </record>

    <record id="un_number_view_search" model="ir.ui.view">
        <field name="name">freight.un.number.search</field>
        <field name="model">freight.un.number</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="proper_shipping_name" />
                <field name="dg_class_id" />
                <separator />
                <filter name="ftr_active" string="Active" domain="[('active', '=', True)]" />
                <filter name="ftr_inactive" string="Inactive" domain="[('active', '=', False)]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter name="grp_dg_class" string="DG Class" context="{'group_by': 'dg_class_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="un_number_action" model="ir.actions.act_window">
        <field name="name">UN Numbers</field>
        <field name="res_model">freight.un.number</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="freight_un_number_menu" name="UN Numbers"
        parent="freight_menu_config_cargo_info"
        sequence="50"
        action="un_number_action"
        groups="viin_freight_management.group_freight_manager" />

</odoo>
