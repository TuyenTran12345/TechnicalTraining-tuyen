<odoo>
  <record id="booking_confirm_resolve_view_form" model="ir.ui.view">
    <field name="name">freight.booking.confirm.resolve.wizard.form</field>
    <field name="model">freight.booking.confirm.resolve.wizard</field>
    <field name="arch" type="xml">
      <form string="Resolve Booking Confirmation">
        <group string="Choose Action">
          <field name="booking_id" invisible="1"/>
          <field name="choice" widget="radio"/>
        </group>
        <group string="Notification Details" invisible="choice != 'notify_stakeholders'">
          <field name="stakeholder_user_ids" widget="many2many_tags_avatar"
            placeholder="Select users to notify..." required="1"/>
          <field name="notification_subject" placeholder="e.g., Urgent: Carrier Decision Required"/>
          <field name="notification_message"
            placeholder="Add specific details about the situation, timeline, or special considerations..."/>
        </group>
        <footer>
          <button string="Apply" type="object" name="action_apply" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
